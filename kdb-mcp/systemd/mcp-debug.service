[Unit]
Description=kdb-mcp Debug Server - T6 Mixed Production Service
Documentation=https://github.com/yourorg/kdb-mcp/docs/SYSTEMD_SERVICE.md
After=network-online.target time-sync.target local-fs.target
Wants=network-online.target
Requires=local-fs.target
DefaultDependencies=no

# Service ordering constraints
Before=multi-user.target
PartOf=multi-user.target

[Service]
# ============================================================================
# Basic Service Configuration
# ============================================================================

Type=notify
ExecStart=/usr/local/bin/kdb-mcp-server \
  --host 192.168.0.38 \
  --port 5678 \
  --log-level info \
  --features audit-trail,ptrace-debug,rate-limiter

ExecReload=/bin/kill -HUP $MAINPID
Restart=on-failure
RestartSec=5s
StartLimitBurst=3
StartLimitIntervalSec=60s

TimeoutStartSec=60s
TimeoutStopSec=30s
TimeoutAbortSec=10s

# ============================================================================
# User & Group Isolation (Layer 1: Privilege Restriction)
# ============================================================================

# DynamicUser=yes  # Uncomment for autogenerated user (requires no CAP_SYS_PTRACE)
# Alternative: Use dedicated user with CAP_SYS_PTRACE capability
User=mcp
Group=mcp

SupplementaryGroups=wheel debugger

# ============================================================================
# Process Lifecycle & State Management
# ============================================================================

StateDirectory=mcp
StateDirectoryMode=0700
RuntimeDirectory=mcp
RuntimeDirectoryMode=0700
CacheDirectory=mcp
CacheDirectoryMode=0700
LogsDirectory=mcp
LogsDirectoryMode=0700

WorkingDirectory=/var/lib/mcp

# ============================================================================
# Resource Limits (Layer 7: Resource Limits)
# ============================================================================

# Memory limits (OOM protection)
# #ASSUME_MEMORY_LIMIT: 512MB max prevents OOM killer from targeting other processes
# #VERIFY: MemoryMax triggers OOM kill of THIS process before system-wide OOM
MemoryMax=512M
MemoryHigh=400M
MemoryAccounting=yes

# CPU limits (prevent CPU starvation of other processes)
CPUQuota=50%
CPUAccounting=yes
CPUWeight=100

# Task limits (prevent fork bomb)
TasksMax=256
TasksAccounting=yes

# File descriptor limits
LimitNOFILE=8192
LimitNPROC=4096
LimitCORE=infinity

# Prevent OOM score manipulation (systemd manages OOM automatically with MemoryMax)
OOMPolicy=stop
OOMScoreAdjust=0

# ============================================================================
# Security Hardening: Privilege Minimization (Layer 1)
# ============================================================================

NoNewPrivileges=yes
PrivateTmp=yes
ProtectHome=yes
ProtectSystem=strict
ReadWritePaths=/var/lib/mcp /var/log/mcp /run/mcp

PrivateDevices=yes
PrivateIPC=yes
PrivateUsers=no  # Required for ptrace (same UID as target)

# ============================================================================
# Security Hardening: Namespace Isolation (Layer 2)
# ============================================================================

ProtectKernelTunables=yes
ProtectKernelModules=yes
ProtectKernelLogs=yes
ProtectControlGroups=yes
ProtectProc=invisible
ProtectClock=yes
ProtectHostname=yes

# ============================================================================
# Security Hardening: Network Restriction (Layer 3)
# ============================================================================

RestrictAddressFamilies=AF_INET AF_INET6 AF_UNIX
IPAddressAllow=192.168.0.0/24
IPAddressDeny=any
IPAddressAllow=127.0.0.1/8
IPAddressAllow=::1/128

# Only allow loopback for health checks
SocketBindAllow=192.168.0.38:5678
SocketBindAllow=127.0.0.1:5678

# ============================================================================
# Security Hardening: Filesystem Access (Layer 4)
# ============================================================================

TemporaryFileSystem=/tmp /var/tmp
TemporaryFileSystemSize=16M:32M

# Allow /etc access for nsswitch (needed for user lookup)
ReadOnlyPaths=/etc /usr /lib /lib64 /boot /sys

# Deny dangerous filesystem mounts
RestrictFilesystems=

# ============================================================================
# Security Hardening: Capability Minimization (Layer 5)
# ============================================================================

# CAP_SYS_PTRACE: Required for ptrace(2) operations (process debugging)
# CAP_NET_BIND_SERVICE: Allow binding to port 5678 (required for non-root)
CapabilityBoundingSet=CAP_SYS_PTRACE CAP_NET_BIND_SERVICE
AmbientCapabilities=CAP_SYS_PTRACE CAP_NET_BIND_SERVICE

# Drop all other capabilities
SecureBits=keep-caps keep-caps-locked noroot-locked no-setuid-fixup-locked no-cap-ambient-raise-locked

# ============================================================================
# Security Hardening: Syscall Filtering (Layer 6)
# ============================================================================

SystemCallFilter=~@clock @module @mount @privileged @raw-io @reboot @swap @obsolete

# Explicitly allow required syscalls
SystemCallFilter=ptrace process_vm_readv process_vm_writev mmap mmap2 madvise

# Seccomp filtering
SeccompFilter=@default
PrivateDevices=yes
ProtectClock=yes
RestrictSUIDSGID=yes
RestrictNamespaces=yes
RestrictRealtime=yes
RemoveIPC=yes
LockPersonality=yes
UMask=0077

# ============================================================================
# Security Hardening: Memory & Code Integrity (Layer 8)
# ============================================================================

# Allow writable executable memory (required for Rust codegen, JIT)
# Set to yes if JIT not needed (improves security)
MemoryDenyWriteExecute=no

# Enforce strict SELinux context (if SELinux enabled on system)
# SELinuxContext=system_u:system_r:mcp_server_t:s0

# Note: ASLR is enabled by kernel by default, no systemd directive needed

# ============================================================================
# Logging & Monitoring
# ============================================================================

StandardOutput=journal
StandardError=journal
StandardInputData=

SyslogIdentifier=mcp-debug
SyslogFacility=daemon
SyslogLevel=info

LogRateLimitBurst=1000
LogRateLimitIntervalSec=30s
LogNamespace=mcp-debug
LogFilterPatterns=

# ============================================================================
# Environment & Configuration
# ============================================================================

Environment=RUST_BACKTRACE=1
Environment=RUST_LOG=mcp_debug=info,kdb_mcp=info,kdb=debug
Environment=RUST_LIB_BACKTRACE=1

EnvironmentFile=/etc/mcp-debug/mcp-debug.env
EnvironmentFile=-/etc/mcp-debug/mcp-debug-local.env

# ============================================================================
# Startup Notification & Health Checks
# ============================================================================

Type=notify
NotifyAccess=main
ExecStartPost=+/usr/local/bin/mcp-debug-health-check.sh

# ============================================================================
# Security Sandbox Summary
# ============================================================================
# Layer 1: Privilege Isolation
#   - NoNewPrivileges=yes (no privilege escalation)
#   - PrivateTmp=yes (isolated /tmp)
#   - ProtectHome=yes (home directory isolation)
#   - ProtectSystem=strict (system files read-only)
#
# Layer 2: Namespace Isolation
#   - PrivateDevices=yes (isolated device namespace)
#   - PrivateIPC=yes (isolated IPC namespace, except for ptrace target)
#   - ProtectKernelTunables=yes (kernel parameters protected)
#   - ProtectControlGroups=yes (cgroup isolation)
#   - ProtectProc=invisible (process namespace isolation)
#   - ProtectClock=yes (clock isolation)
#   - ProtectHostname=yes (hostname isolation)
#
# Layer 3: Network Restriction
#   - RestrictAddressFamilies=AF_INET AF_INET6 AF_UNIX (IPv4/6/Unix sockets only)
#   - IPAddressAllow=192.168.0.0/24 (white-list network access)
#   - IPAddressDeny=any (deny all other addresses)
#   - SocketBindAllow=192.168.0.38:5678 (whitelist MCP port)
#
# Layer 4: Filesystem Access
#   - TemporaryFileSystem=/tmp /var/tmp (ephemeral /tmp with size limit)
#   - ReadOnlyPaths=/etc /usr /lib* /boot /sys (system files read-only)
#   - ReadWritePaths=/var/lib/mcp /var/log/mcp /run/mcp (allow write to state)
#
# Layer 5: Capability Minimization
#   - CapabilityBoundingSet=CAP_SYS_PTRACE CAP_NET_BIND_SERVICE (drop all others)
#   - AmbientCapabilities=CAP_SYS_PTRACE CAP_NET_BIND_SERVICE (only ambient caps)
#   - SecureBits: prevent capability escalation
#
# Layer 6: Syscall Filtering
#   - SystemCallFilter=~@* (blacklist dangerous syscalls)
#   - SystemCallFilter=ptrace process_vm_* (whitelist ptrace syscalls)
#
# Layer 7: Resource Limits (OOM Protection)
#   - MemoryMax=512M (hard memory limit, prevents OOM killer)
#   - MemoryHigh=400M (soft memory limit, notifications)
#   - OOMPolicy=stop (stop process on OOM, don't kill other processes)
#   - OOMScoreAdjust=0 (neutral OOM score)
#   - CPUQuota=50% (50% CPU quota)
#   - TasksMax=256 (256 tasks maximum, fork bomb prevention)
#   - LimitNOFILE=8192 (max file descriptors)
#
# Layer 8: Memory & Code Integrity
#   - MemoryDenyWriteExecute=no (allows JIT, but set to yes if not needed)
#   - ASLR enabled by kernel (no systemd directive needed)
#
# SUMMARY: 40+ hardening directives implementing defense-in-depth security model
# Security Score Target: ≥8.5/10 (systemd-analyze security)

[Install]
WantedBy=multi-user.target
Alias=mcp.service
Alias=mcp-server.service
DefaultInstance=1
