);

#[cfg(feature = "nightly-atomic")]
criterion_main!(
    corpus_reader_benches,
    signature_writer_benches,
    lsh_bucketer_benches,
    union_find_benches,
    pipeline_benches,
    crash_recovery_benches,
);

#[cfg(not(feature = "nightly-atomic"))]
