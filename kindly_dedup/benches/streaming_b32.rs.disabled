/// Benchmark: Memory boundedness validation
///
/// **Target**: <275 MB memory @ 100K docs
///
/// **Setup**:
/// - Create 100K-doc corpus
/// - Measure memory usage (constant regardless of scale)
#[cfg(feature = "nightly-atomic")]
fn bench_memory_boundedness(c: &mut Criterion) {
    let mut group = c.benchmark_group("memory_boundedness");
    group.sample_size(10);

    // Create test corpus (100K lines)
    let corpus_path = "/tmp/bench_memory_100k.jsonl";
    {
        let mut file = fs::File::create(corpus_path).expect("Failed to create corpus");
        for i in 0..100_000 {
            writeln!(file, r#"{{"id":{},"text":"{}"}}"#, i, TEST_DOC).expect("Failed to write line");
        }
    }

    group.bench_function("pipeline_100k_docs_memory", |b| {
        b.iter(|| {
            let pipeline = StreamingDedupPipelineCapsule::create(
                black_box(corpus_path),
                black_box(100_000),
                black_box(5),
            ).expect("Failed to create pipeline");

            // Process full pipeline (memory should stay <275 MB)
            let stats = pipeline.process().expect("Failed to process");
            black_box(stats);

            // In production, would measure RSS here (requires sysinfo crate)
        });
    });

    let _ = fs::remove_file(corpus_path);
    group.finish();
}

// ==============================================================================
// CRASH RECOVERY BENCHMARKS
// ==============================================================================

/// Benchmark: Generation counter crash detection
///
/// **Target**: <100ns per detect_crash()
///
/// **Setup**:
/// - Create writer
/// - Measure detect_crash() latency
fn bench_crash_detection(c: &mut Criterion) {
    let mut group = c.benchmark_group("crash_recovery");
    group.sample_size(1000);

    group.bench_function("detect_crash_latency", |b| {
        let writer = StreamingSignatureWriterCapsule::create("/tmp/bench_crash.mmap", 10_000)
            .expect("Failed to create writer");

        b.iter(|| {
            let is_crash = writer.detect_crash();
            black_box(is_crash);
        });

        drop(writer);
        let _ = fs::remove_file("/tmp/bench_crash.mmap");
    });

    group.finish();
}

/// Benchmark: Generation counter recovery
///
/// **Target**: <1ms per recover()
///
/// **Setup**:
/// - Simulate crash (odd generation)
/// - Measure recover() latency
fn bench_crash_recovery(c: &mut Criterion) {
    let mut group = c.benchmark_group("crash_recovery");
    group.sample_size(500);

    group.bench_function("recover_latency", |b| {
        b.iter(|| {
            let mut writer = StreamingSignatureWriterCapsule::create("/tmp/bench_recover.mmap", 10_000)
                .expect("Failed to create writer");

            // Write some docs
            for i in 0..100 {
                writer.write_document(i, TEST_DOC).expect("Failed to write");
            }
            writer.sync().expect("Failed to sync");

            // Simulate crash (set generation to odd)
            writer.generation.store(5, std::sync::atomic::Ordering::SeqCst);
            assert!(writer.detect_crash());

            // Measure recovery latency
            let start = std::time::Instant::now();
            writer.recover().expect("Failed to recover");
            let elapsed = start.elapsed();
            black_box(elapsed);

            drop(writer);
            let _ = fs::remove_file("/tmp/bench_recover.mmap");
        });
    });

    group.finish();
}

