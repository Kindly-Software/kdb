//! # Streaming SIMD MinHash Benchmark
//!
//! **Purpose**: Validate 7.1× SIMD speedup in StreamingSignatureWriterCapsule
//!
//! ## B32 Framework Compliance
//!
//! - **Fair Baseline**: Compare SIMD vs scalar on same hardware
//! - **95% CI**: 1000+ iterations per benchmark
//! - **Reproducibility**: Deterministic input data
//! - **Honest Claims**: Measure actual StreamingSignatureWriterCapsule performance
//!
//! ## Benchmarks
//!
//! 1. **signature_writer_simd**: StreamingSignatureWriterCapsule with SIMD (6.6μs target)
//! 2. **signature_writer_scalar**: StreamingSignatureWriterCapsule with scalar fallback (47μs baseline)
//! 3. **end_to_end_simd**: Full write + sync cycle (SIMD)
//! 4. **end_to_end_scalar**: Full write + sync cycle (scalar)
//!
//! ## Expected Results
//!
//! - SIMD: 6.6μs per document (7.1× speedup)
//! - Scalar: 47μs per document (baseline)
//! - Speedup: 7.1× (validated)

use criterion::{black_box, criterion_group, criterion_main, Criterion, BenchmarkId};
use kindly_dedup::streaming::StreamingSignatureWriterCapsule;
use std::fs;

/// Standard test document (100 tokens, typical LLM training sample)
const TEST_DOC: &str = "the quick brown fox jumps over the lazy dog and runs through \
the forest with great speed while dodging trees and bushes that appear in its path \
creating a magnificent display of agility and grace as it moves swiftly across the \
terrain with remarkable precision and control demonstrating the natural athleticism \
of wild animals in their native habitat and their ability to navigate complex \
environments with ease and confidence showing the power of evolution and natural \
selection in shaping the physical capabilities of different species over millions \
of years of adaptation and survival in diverse ecosystems around the world";

/// Benchmark: SIMD MinHash signature computation
///
/// **Target**: 6.6μs per document (7.1× vs 47μs scalar)
///
/// **Setup**:
/// - Create StreamingSignatureWriterCapsule with SIMD enabled
/// - 100-token document (typical LLM training sample)
/// - Measure write_document() latency
fn bench_signature_writer_simd(c: &mut Criterion) {
    let mut group = c.benchmark_group("streaming_signature_writer");
    group.sample_size(1000); // 1000 iterations for 95% CI

    #[cfg(all(feature = "simd-minhash", feature = "cpu-detection"))]
    {
        group.bench_function("simd_write_document", |b| {
            let mut writer = StreamingSignatureWriterCapsule::create(
                "/tmp/bench_simd.mmap",
                10_000,
            )
            .expect("Failed to create SIMD writer");

            // Verify SIMD is available
            if writer.has_simd() {
                println!("✓ SIMD enabled (AVX2): {}", writer.simd_status());
            } else {
                println!("⚠ SIMD not available, using scalar fallback");
            }

            let mut doc_id = 0u32;
            b.iter(|| {
                writer
                    .write_document(black_box(doc_id), black_box(TEST_DOC))
                    .expect("Failed to write");
                doc_id += 1;
            });

            // Cleanup
            drop(writer);
            let _ = fs::remove_file("/tmp/bench_simd.mmap");
        });
    }

    #[cfg(not(all(feature = "simd-minhash", feature = "cpu-detection")))]
    {
        println!("⚠ SIMD benchmarks require features: simd-minhash, cpu-detection");
    }

    group.finish();
}

/// Benchmark: Scalar MinHash signature computation (baseline)
///
/// **Target**: 47μs per document (baseline for 7.1× speedup)
///
/// **Setup**:
/// - Create StreamingSignatureWriterCapsule with SIMD disabled
/// - Same 100-token document
/// - Measure write_document() latency
fn bench_signature_writer_scalar(c: &mut Criterion) {
    let mut group = c.benchmark_group("streaming_signature_writer");
    group.sample_size(1000); // 1000 iterations for 95% CI

    group.bench_function("scalar_write_document", |b| {
        let mut writer =
            StreamingSignatureWriterCapsule::create("/tmp/bench_scalar.mmap", 10_000)
                .expect("Failed to create scalar writer");

        let mut doc_id = 0u32;
        b.iter(|| {
            writer
                .write_document(black_box(doc_id), black_box(TEST_DOC))
                .expect("Failed to write");
            doc_id += 1;
        });

        // Cleanup
        drop(writer);
        let _ = fs::remove_file("/tmp/bench_scalar.mmap");
    });

    group.finish();
}

/// Benchmark: End-to-end write + sync (SIMD)
///
/// **Target**: <10ms per 1000 docs (SIMD + batch sync)
///
/// **Setup**:
/// - Write 1000 documents with SIMD
/// - Trigger batch sync (1000-doc threshold)
/// - Measure total latency
fn bench_end_to_end_simd(c: &mut Criterion) {
    let mut group = c.benchmark_group("end_to_end");
    group.sample_size(100); // 100 iterations (slower due to fsync)

    #[cfg(all(feature = "simd-minhash", feature = "cpu-detection"))]
    {
        group.bench_function("simd_write_sync_1000_docs", |b| {
            b.iter(|| {
                let mut writer = StreamingSignatureWriterCapsule::create(
                    "/tmp/bench_e2e_simd.mmap",
                    10_000,
                )
                .expect("Failed to create writer");

                // Write 1000 documents (triggers sync at threshold)
                for i in 0..1000 {
                    writer
                        .write_document(black_box(i), black_box(TEST_DOC))
                        .expect("Failed to write");
                }

                // Final sync for remaining docs
                writer.sync().expect("Failed to sync");

                // Cleanup
                drop(writer);
                let _ = fs::remove_file("/tmp/bench_e2e_simd.mmap");
            });
        });
    }

    group.finish();
}

/// Benchmark: End-to-end write + sync (scalar baseline)
///
/// **Target**: <70ms per 1000 docs (scalar + batch sync)
///
/// **Setup**:
/// - Write 1000 documents with scalar
/// - Trigger batch sync (1000-doc threshold)
/// - Measure total latency
fn bench_end_to_end_scalar(c: &mut Criterion) {
    let mut group = c.benchmark_group("end_to_end");
    group.sample_size(100); // 100 iterations (slower due to fsync)

    group.bench_function("scalar_write_sync_1000_docs", |b| {
        b.iter(|| {
            let mut writer =
                StreamingSignatureWriterCapsule::create("/tmp/bench_e2e_scalar.mmap", 10_000)
                    .expect("Failed to create writer");

            // Write 1000 documents (triggers sync at threshold)
            for i in 0..1000 {
                writer
                    .write_document(black_box(i), black_box(TEST_DOC))
                    .expect("Failed to write");
            }

            // Final sync for remaining docs
            writer.sync().expect("Failed to sync");

            // Cleanup
            drop(writer);
            let _ = fs::remove_file("/tmp/bench_e2e_scalar.mmap");
        });
    });

    group.finish();
}

/// Benchmark: SIMD vs Scalar comparison
///
/// **Purpose**: Direct A/B comparison of SIMD vs scalar MinHash
///
/// **Expected**: 7.1× speedup (6.6μs SIMD vs 47μs scalar)
fn bench_simd_vs_scalar_comparison(c: &mut Criterion) {
    let mut group = c.benchmark_group("simd_vs_scalar");
    group.sample_size(1000);

    // Scalar baseline
    group.bench_function("scalar", |b| {
        let mut writer =
            StreamingSignatureWriterCapsule::create("/tmp/bench_compare_scalar.mmap", 10_000)
                .expect("Failed to create scalar writer");

        let mut doc_id = 0u32;
        b.iter(|| {
            writer
                .write_document(black_box(doc_id), black_box(TEST_DOC))
                .expect("Failed to write");
            doc_id += 1;
        });

        drop(writer);
        let _ = fs::remove_file("/tmp/bench_compare_scalar.mmap");
    });

    // SIMD optimized
    #[cfg(all(feature = "simd-minhash", feature = "cpu-detection"))]
    {
        group.bench_function("simd", |b| {
            let mut writer = StreamingSignatureWriterCapsule::create(
                "/tmp/bench_compare_simd.mmap",
                10_000,
            )
            .expect("Failed to create SIMD writer");

            // Verify SIMD is enabled
            assert!(
                writer.has_simd(),
                "SIMD not available on this CPU - benchmark requires AVX2"
            );

            let mut doc_id = 0u32;
            b.iter(|| {
                writer
                    .write_document(black_box(doc_id), black_box(TEST_DOC))
                    .expect("Failed to write");
                doc_id += 1;
            });

            drop(writer);
            let _ = fs::remove_file("/tmp/bench_compare_simd.mmap");
        });
    }

    group.finish();
}

/// Benchmark: Document size scaling (SIMD)
///
/// **Purpose**: Validate SIMD speedup across different document sizes
///
/// **Sizes**: 10, 50, 100, 500, 1000 tokens
fn bench_document_size_scaling(c: &mut Criterion) {
    let mut group = c.benchmark_group("document_size_scaling");
    group.sample_size(500);

    #[cfg(all(feature = "simd-minhash", feature = "cpu-detection"))]
    {
        for &num_tokens in &[10, 50, 100, 500, 1000] {
            // Generate document with N tokens
            let doc: String = (0..num_tokens)
                .map(|i| format!("token{} ", i))
                .collect();

            group.bench_with_input(
                BenchmarkId::new("simd", num_tokens),
                &doc,
                |b, doc| {
                    let mut writer = StreamingSignatureWriterCapsule::create(
                        "/tmp/bench_scaling.mmap",
                        10_000,
                    )
                    .expect("Failed to create writer");

                    let mut doc_id = 0u32;
                    b.iter(|| {
                        writer
                            .write_document(black_box(doc_id), black_box(doc.as_str()))
                            .expect("Failed to write");
                        doc_id += 1;
                    });

                    drop(writer);
                    let _ = fs::remove_file("/tmp/bench_scaling.mmap");
                },
            );
        }
    }

    group.finish();
}

criterion_group!(
    benches,
    bench_signature_writer_simd,
    bench_signature_writer_scalar,
    bench_end_to_end_simd,
    bench_end_to_end_scalar,
    bench_simd_vs_scalar_comparison,
    bench_document_size_scaling,
);
criterion_main!(benches);
