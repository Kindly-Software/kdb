# SMTP Configuration for Kindly Dedup Email Delivery
# Copy this file to smtp_config.toml and fill in your credentials
#
# Supported locations (in search order):
# 1. ./smtp_config.toml (current directory)
# 2. ~/.config/kindly_dedup/smtp_config.toml (user config)
# 3. /etc/kindly_dedup/smtp_config.toml (system config, Linux only)

[smtp]
# SMTP server hostname (e.g., smtp.gmail.com, smtp.office365.com)
server = "smtp.gmail.com"

# SMTP port (typically 587 for STARTTLS, 465 for TLS)
port = 587

# SMTP authentication username (typically your email address)
username = "your-email@gmail.com"

# SMTP authentication password
# IMPORTANT: Use app-specific password, NOT your main account password!
# Gmail: https://myaccount.google.com/apppasswords (requires 2FA)
# Outlook: Use your regular password (app passwords not needed)
password = "your-app-password-here"

# Use STARTTLS (true for port 587, false for plain or TLS on 465)
use_tls = true

[email]
# Sender email address (must match SMTP username)
from = "your-email@gmail.com"

# Sender display name (optional)
from_name = "Kindly Dedup Compliance"

# Recipient email addresses (supports multiple recipients)
to = ["recipient1@example.com", "compliance@company.com"]

# Email subject line
subject = "Kindly Dedup - Enterprise Compliance Report"

# Email body (plain text, will be wrapped with Byzantine Purple × Gold HTML branding)
body = """Please find attached the Kindly Dedup Enterprise Compliance Report.

This report contains audit trail verification results and compliance status.

Generated by Kindly Dedup v2.0
https://dedup.kindly.software"""

# -----------------------------------------------------------------------------
# COMMON SMTP PROVIDER SETTINGS
# -----------------------------------------------------------------------------

# Gmail (requires app-specific password)
# [smtp]
# server = "smtp.gmail.com"
# port = 587
# username = "your-email@gmail.com"
# password = "app-password"  # https://myaccount.google.com/apppasswords
# use_tls = true

# Outlook / Office 365
# [smtp]
# server = "smtp.office365.com"
# port = 587
# username = "your-email@outlook.com"
# password = "your-password"
# use_tls = true

# Yahoo Mail
# [smtp]
# server = "smtp.mail.yahoo.com"
# port = 587
# username = "your-email@yahoo.com"
# password = "app-password"  # https://login.yahoo.com/account/security
# use_tls = true

# Custom SMTP Server
# [smtp]
# server = "smtp.yourcompany.com"
# port = 587
# username = "your-username"
# password = "your-password"
# use_tls = true

# -----------------------------------------------------------------------------
# SECURITY NOTES
# -----------------------------------------------------------------------------
#
# 1. NEVER commit this file with real credentials to version control
# 2. Set file permissions to 0600 (user read/write only):
#    chmod 600 smtp_config.toml
# 3. Use app-specific passwords instead of account passwords
# 4. Store in ~/.config/kindly_dedup/ for better security than current directory
# 5. Consider using environment variables for credentials in production
#    (future enhancement: support SMTP_PASSWORD env var)
