  <!-- WEEKS 1-2: StreamingTokenizerCapsule -->
  <week number="1-2" duration="10 days">
    <title>StreamingTokenizerCapsule (T5 Streaming)</title>
    <objective>
      Implement single-threaded streaming tokenizer that eliminates 70-80% of
      parallel worker overhead. Zero-copy Arc&lt;str&gt; token sharing.
    </objective>

    <deliverables>
      <file path="src/streaming_tokenizer.rs" lines="400">
        <description>StreamingTokenizerCapsule implementation</description>
        <components>
          <component name="StreamingTokenizerCapsule">64-byte aligned capsule</component>
          <component name="TokenBatch">Zero-copy token batch structure</component>
          <component name="add_document">Streaming document processing</component>
        </components>
      </file>
      <file path="tests/streaming_tokenizer_tests.rs" lines="200">
        <description>Unit tests for tokenizer (40 tests)</description>
        <test-categories>
          <category name="basic" count="10">Single doc, batch, wraparound</category>
          <category name="zero-copy" count="10">Arc&lt;str&gt; sharing, no allocation</category>
          <category name="edge-cases" count="10">Partial batch, special chars</category>
          <category name="performance" count="10">Throughput validation</category>
        </test-categories>
      </file>
      <file path="Cargo.toml" lines="5">
        <description>Feature flag updates for streaming-tokenizer</description>
      </file>
    </deliverables>

    <milestones-achieved>
      <milestone id="m1" status="COMPLETE"/>
    </milestones-achieved>

    <testing-checkpoint>
      <phase name="unit" tests="40"/>
      <assertion>All 40 unit tests pass</assertion>
      <assertion>Zero-copy Arc&lt;str&gt; verified with Valgrind</assertion>
      <assertion>Circular buffer wraparound validated</assertion>
      <measurement name="throughput">60K docs/sec @ 1 thread (baseline)</measurement>
    </testing-checkpoint>

    <risks>
      <risk level="low">Arc&lt;str&gt; zero-copy correctness</risk>
      <mitigation>Use Valgrind to verify no heap allocations on hot path</mitigation>
    </risks>

    <dependencies-satisfied>
      <dependency>None (start of pipeline)</dependency>
    </dependencies-satisfied>
  </week>

  <!-- WEEKS 3-4: StreamingMinHashBuilderCapsule -->
  <week number="3-4" duration="10 days">
    <title>StreamingMinHashBuilderCapsule (T5 + T2 SIMD)</title>
    <objective>
      Implement incremental MinHash computation that eliminates O(100K) scan
      on each signature extraction. Use SIMD for token hashing (4× speedup).
    </objective>

    <dependencies-required>
      <dependency id="m1">StreamingTokenizer must be complete</dependency>
    </dependencies-required>

    <deliverables>
      <file path="src/streaming_minhash.rs" lines="300">
        <description>StreamingMinHashBuilderCapsule implementation</description>
        <components>
          <component name="StreamingMinHashBuilderCapsule">64-byte aligned</component>
          <component name="add_token">Incremental MinHash update (O(128))</component>
          <component name="extract">Signature extraction (no scan)</component>
          <component name="simd_hash">SIMD token hashing (portable_simd, 4×)</component>
        </components>
      </file>
      <file path="tests/streaming_minhash_tests.rs" lines="150">
        <description>Unit tests for MinHash (25 tests)</description>
        <test-categories>
          <category name="correctness" count="10">Deterministic signatures</category>
          <category name="simd" count="10">SIMD vs scalar equivalence</category>
          <category name="performance" count="5">O(128) extraction validated</category>
        </test-categories>
      </file>
    </deliverables>

    <milestones-achieved>
      <milestone id="m2" status="COMPLETE"/>
    </milestones-achieved>

    <testing-checkpoint>
      <phase name="unit" tests="25"/>
      <phase name="property" tests="10" type="proptest">Determinism, SIMD equivalence</phase>
      <assertion>O(128) extraction verified (not O(100K))</assertion>
      <assertion>SIMD hash matches scalar baseline</assertion>
      <measurement name="speedup-simd">4× text hashing speedup (portable_simd)</measurement>
      <measurement name="speedup-extraction">1.2-1.3× signature extraction</measurement>
    </testing-checkpoint>

    <risks>
      <risk level="medium">SIMD hash correctness across platforms</risk>
      <mitigation>Run proptest with 10K iterations comparing scalar vs SIMD</mitigation>
      <risk level="low">O(128) vs O(100K) change correctness</risk>
      <mitigation>Verify with deterministic test corpus</mitigation>
    </risks>

    <performance-targets>
      <target metric="extraction_time" value="1.2-1.3×">vs O(100K) scan baseline</target>
      <target metric="simd_speedup" value="4×">vs scalar hashing</target>
      <target metric="compound" value="2.4-3.9×">SIMD + extraction combined</target>
    </performance-targets>
  </week>

  <!-- WEEKS 5-6: StreamingLshBucketerCapsule -->
  <week number="5-6" duration="10 days">
    <title>StreamingLshBucketerCapsule (T5 Streaming + Lockfree Treiber)</title>
    <objective>
      Implement lockfree LSH bucketing using Treiber stack. Eliminate CAS
      contention (single atomic swap per insert). Shard buckets per-worker.
    </objective>

    <dependencies-required>
      <dependency id="m2">StreamingMinHashBuilder must be complete</dependency>
    </dependencies-required>

    <deliverables>
      <file path="src/streaming_lsh_bucketer.rs" lines="350">
        <description>StreamingLshBucketerCapsule implementation</description>
        <components>
          <component name="StreamingLshBucketerCapsule">128-byte aligned (cache line)</component>
          <component name="LshNode">Lockfree linked list node</component>
          <component name="add_signature">Treiber stack insert (single atomic)</component>
          <component name="treiber_push">Lockfree push operation</component>
        </components>
      </file>
      <file path="tests/streaming_lsh_bucketer_tests.rs" lines="150">
        <description>Unit + property tests for LSH (20 tests)</description>
        <test-categories>
          <category name="lockfree" count="10">Treiber stack correctness</category>
          <category name="contention" count="5">Multi-thread CAS behavior</category>
          <category name="performance" count="5">Throughput validation</category>
        </test-categories>
      </file>
    </deliverables>

    <milestones-achieved>
      <milestone id="m3" status="COMPLETE"/>
    </milestones-achieved>

    <testing-checkpoint>
      <phase name="unit" tests="15"/>
      <phase name="property" tests="5" type="proptest">Linearizability, ABA prevention</phase>
      <assertion>Treiber stack correctness verified (single atomic swap)</assertion>
      <assertion>No CAS retry loops detected (single-shot atomic)</assertion>
      <measurement name="contention">CAS success rate >95% (minimal retry)</measurement>
      <measurement name="throughput">&lt;100ns per band insert (lockfree)</measurement>
    </testing-checkpoint>

    <risks>
      <risk level="medium">Treiber stack ABA problem (if not careful with pointers)</risk>
      <mitigation>Use atomic::Box or epoch-based reclamation, document assumptions</mitigation>
      <risk level="low">Per-worker sharding correctness</risk>
      <mitigation>Property-based test to verify all buckets populated</mitigation>
    </risks>

    <performance-targets>
      <target metric="contention" value="&lt;100ns">per band insert (lockfree Treiber)</target>
      <target metric="success_rate" value="&gt;95%">CAS success on first try</target>
      <target metric="speedup" value="1.3-1.5×">vs baseline with contention</target>
    </performance-targets>
  </week>

  <!-- WEEKS 7-8: Batch Coordination -->
  <week number="7-8" duration="10 days">
    <title>BatchCoordinatorCapsule + WorkerBatchQueue (T4 Batch)</title>
    <objective>
      Implement batch coordination and work-stealing queue. DualAtomicU64 for
      head/tail tracking. Chase-Lev deque for work distribution.
    </objective>

    <dependencies-required>
      <dependency id="m3">StreamingLshBucketer must be complete</dependency>
    </dependencies-required>

    <deliverables>
      <file path="src/batch_coordinator.rs" lines="250">
        <description>BatchCoordinatorCapsule implementation</description>
        <components>
          <component name="BatchCoordinatorCapsule">128-byte aligned (cache line)</component>
          <component name="DualAtomicU64">Head/tail coordination</component>
          <component name="batch_complete">Two-phase commit</component>
        </components>
      </file>
      <file path="src/worker_batch_queue.rs" lines="300">
        <description>WorkerBatchQueue (Chase-Lev deque) implementation</description>
        <components>
          <component name="WorkerBatchQueue">Lockfree work-stealing queue</component>
          <component name="push">Producer push (single thread)</component>
          <component name="pop">Worker pop (LIFO)</component>
          <component name="steal">Idle thread steal (FIFO)</component>
        </components>
      </file>
      <file path="tests/batch_coordination_tests.rs" lines="120">
        <description>Unit + integration tests for coordination (20 tests)</description>
        <test-categories>
          <category name="batch" count="10">Batch creation, completion, flushing</category>
          <category name="queue" count="5">Work-stealing, load balance</category>
          <category name="coordination" count="5">DualAtomicU64 ordering</category>
        </test-categories>
      </file>
    </deliverables>

    <milestones-achieved>
      <milestone id="m4" status="COMPLETE"/>
    </milestones-achieved>

    <testing-checkpoint>
      <phase name="unit" tests="20"/>
      <phase name="property" tests="10" type="proptest">Linearizability, CAS-free properties</phase>
      <phase name="loom" tests="5">Memory ordering validation (exhaustive)</phase>
      <assertion>DualAtomicU64 memory ordering correct (Release/Acquire)</assertion>
      <assertion>Chase-Lev deque linearizable (all work items processed)</assertion>
      <assertion>Work-stealing load balance within 5% variance</assertion>
      <measurement name="coordination_overhead">&lt;1% of worker time</measurement>
      <measurement name="batch_amortization">&lt;10μs per 1000-doc batch</measurement>
    </testing-checkpoint>

    <risks>
      <risk level="high">Memory ordering on DualAtomicU64</risk>
      <mitigation>Use loom crate to exhaustively test all memory orderings</mitigation>
      <risk level="medium">Chase-Lev deque correctness</risk>
      <mitigation>Prove against published algorithm (Chase &amp; Lev, 2005)</mitigation>
      <risk level="low">Batch boundary handling</risk>
      <mitigation>Test with partial batches (997 docs, 1001 docs)</mitigation>
    </risks>

    <performance-targets>
      <target metric="coordination_overhead" value="&lt;1%">of total worker time</target>
      <target metric="batch_amortization" value="&lt;10μs">per 1000-doc batch</target>
      <target metric="load_balance" value="&lt;5%">variance across workers</target>
    </performance-targets>
  </week>

