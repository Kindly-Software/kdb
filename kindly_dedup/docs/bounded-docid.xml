    <alternative id="3" selected="false">
      <name>Range-Checked Smart Pointer</name>
      <complexity>9/10 (very complex)</complexity>
      <pros>Type-level range encoding</pros>
      <cons>Requires unstable const generics, cannot handle dynamic capacity</cons>
    </alternative>

    <alternative id="4" selected="false">
      <name>External Crate (index_vec)</name>
      <complexity>4/10 (moderate)</complexity>
      <pros>Battle-tested (used in rustc), zero overhead</pros>
