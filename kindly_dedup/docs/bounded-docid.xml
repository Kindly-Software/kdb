    <alternative id="5" selected="false">
      <name>Builder Pattern + Typestate</name>
      <complexity>8/10 (very complex)</complexity>
      <pros>Protocol enforcement (compile-time state machine)</pros>
      <cons>API complexity, overkill for simple bounds check</cons>
    </alternative>
  </design-alternatives>
</architecture>

