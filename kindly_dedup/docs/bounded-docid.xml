<!-- Version: 2.0.0 | Date: 2025-11-16 | Framework: Q12-ULTRATHINK + UCE34 -->
<bounded-docid version="2.0.0">

<!-- ============================================================================
     EXECUTIVE SUMMARY
     ============================================================================ -->
<summary>
  <problem>
    <root-cause>Unbounded DocumentId indexing (type DocId = usize) caused segmentation fault (exit 139)</root-cause>
    <trigger>Custom corpus with doc_id >= pipeline.capacity</trigger>
    <evidence>/tmp/CRITICAL_FIX_ANALYSIS.md (8 binary search tests)</evidence>
    <violation>Violates "Make Invalid States Unrepresentable" principle</violation>
  </problem>

  <solution>
    <approach>Type-safe bounded DocumentId (branded newtype with private field)</approach>
    <benefit>Compile-time proof of correctness (impossible to construct invalid IDs)</benefit>
    <performance>Zero-cost abstraction (sizeof(DocumentId) == sizeof(usize))</performance>
    <compatibility>100% backward compatible (feature-gated, old API preserved)</compatibility>
  </solution>

  <value-proposition>
    <primary>Architectural correctness (not performance optimization)</primary>
    <secondary>Zero-panic contracts for safety-critical systems</secondary>
    <tertiary>0.06% speedup (negligible, but proves zero-cost)</tertiary>
  </value-proposition>
</summary>

<!-- ============================================================================
     CORE TYPES
     ============================================================================ -->
<types>
  <type name="DocumentId">
    <definition><![CDATA[
#[derive(Copy, Clone, PartialEq, Eq, Hash, PartialOrd, Ord)]
pub struct DocumentId {
    id: usize,  // PRIVATE - cannot construct outside module
}
    ]]></definition>

    <properties>
      <property name="size">8 bytes (same as usize)</property>
      <property name="alignment">8 bytes</property>
      <property name="overhead">0% (zero-cost abstraction)</property>
      <property name="traits">Copy, Clone, Debug, Display, PartialEq, Eq, Hash, PartialOrd, Ord</property>
    </properties>

    <invariants>
      <invariant id="BOUNDS">#ASSUME_ID_IN_BOUNDS: All DocumentIds &lt; capacity</invariant>
      <invariant id="PRIVATE">#ASSUME_PRIVATE_FIELD: Only DocumentIdAllocator can create</invariant>
      <invariant id="IMMUTABLE">DocumentId is Copy (no mutation after creation)</invariant>
    </invariants>

    <api>
      <method name="new_unchecked" visibility="pub(crate)">
        <signature>pub(crate) const fn new_unchecked(id: usize) -> Self</signature>
        <safety>Caller MUST ensure id &lt; capacity</safety>
        <usage>Only callable within bounded_docid module</usage>
      </method>

      <method name="as_usize" visibility="pub">
        <signature>pub const fn as_usize(self) -> usize</signature>
        <performance>#[inline(always)], zero-cost</performance>
        <usage>For array indexing (guaranteed in-bounds)</usage>
      </method>
    </api>
  </type>

  <type name="DocumentIdAllocator">
    <definition><![CDATA[
pub struct DocumentIdAllocator {
    capacity: usize,
}
    ]]></definition>

    <purpose>Factory for creating validated DocumentIds</purpose>

    <api>
      <method name="new">
        <signature>pub const fn new(capacity: usize) -> Self</signature>
        <usage>Create allocator for pipeline with given capacity</usage>
      </method>

      <method name="sequential">
        <signature>pub fn sequential(&self) -> impl Iterator&lt;Item = DocumentId&gt;</signature>
        <behavior>Yields DocumentIds 0..capacity</behavior>
        <performance>Zero-cost (equivalent to (0..capacity).map())</performance>
        <common-case>Use for synthetic corpus (pre-validated sequential IDs)</common-case>
      </method>

      <method name="validate">
        <signature>pub fn validate(&self, id: usize) -> Result&lt;DocumentId, BoundsError&gt;</signature>
        <behavior>Validates external ID, returns branded DocumentId</behavior>
        <performance>1 comparison (~1ns), check ONCE at load time</performance>
        <common-case>Use for custom corpus (external IDs need validation)</common-case>
      </method>

      <method name="validate_batch">
        <signature>pub fn validate_batch(&self, ids: &[usize]) -> Result&lt;Vec&lt;DocumentId&gt;, BoundsError&gt;</signature>
        <behavior>Validates multiple IDs in one call</behavior>
        <performance>Vectorizable (faster than loop of validate() calls)</performance>
      </method>
    </api>
  </type>

  <type name="BoundsError">
    <definition><![CDATA[
#[derive(Debug, Clone, PartialEq, Eq, thiserror::Error)]
pub enum BoundsError {
    #[error("DocumentId {id} out of bounds (capacity: {capacity})")]
    OutOfBounds { id: usize, capacity: usize },
}
    ]]></definition>

    <purpose>Error type for bounds validation failures</purpose>
    <integration>thiserror for ergonomic error handling</integration>
  </type>
</types>

