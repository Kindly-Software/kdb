<architecture>
  <pattern name="Branded Newtype">
    <description>Private field prevents external construction, only factory can create instances</description>
    <rust-pattern>Newtype pattern with module privacy (idiomatic Rust)</rust-pattern>
    <guarantees>Type system enforces validation boundary</guarantees>
  </pattern>

  <validation-strategy>
    <approach>Load-Time Validation</approach>
    <timing>Check ONCE at corpus load (not per add_document call)</timing>
    <performance>Amortized &lt;1ns per document (single comparison)</performance>
    <correctness>Type system proves all subsequent uses are safe</correctness>
  </validation-strategy>

  <tier-classification>
    <tier id="T0" name="Auditable">
      <rationale>Type-safe bounds checking, compile-time verification</rationale>
      <verification>Zero-cost abstraction (same size as usize, identical assembly)</verification>
    </tier>
  </tier-classification>

  <design-alternatives>
    <alternative id="1" selected="true">
      <name>Simple Newtype with Module Privacy</name>
      <complexity>2/10 (very simple)</complexity>
      <pros>Zero-cost, idiomatic, works on stable, easy to understand</pros>
      <cons>Module discipline required (keep id field private)</cons>
    </alternative>

    <alternative id="2" selected="false">
      <name>Phantom Type with Lifetime Branding</name>
      <complexity>7/10 (advanced)</complexity>
      <pros>Compile-time enforcement, cannot mix IDs from different pipelines</pros>
