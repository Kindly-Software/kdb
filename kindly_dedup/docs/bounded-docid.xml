<!-- ============================================================================
     USAGE EXAMPLES
     ============================================================================ -->
<usage-examples>
  <example name="Synthetic Corpus">
    <before><![CDATA[
// Old API (still works)
let corpus = generate_synthetic_corpus(1000);
let mut pipeline = DedupPipeline::new(1000, &cpu_caps);

for doc in corpus {
    pipeline.add_document(doc.id, &doc.text)?;  // 2 checks per call
}
    ]]></before>

    <after><![CDATA[
// New API (type-safe)
let (texts, allocator) = generate_synthetic_corpus_bounded(1000);
let mut pipeline = DedupPipeline::new(1000, &cpu_caps);

for (id, text) in allocator.sequential().zip(texts) {
    pipeline.add_document_bounded(id, &text)?;  // 0 checks per call
}
    ]]></after>
  </example>

  <example name="Custom Corpus">
    <before><![CDATA[
// Old API (runtime checks in add_document)
let corpus = load_custom_corpus("data.txt")?;
let mut pipeline = DedupPipeline::new(corpus.len(), &cpu_caps);

for doc in corpus {
    pipeline.add_document(doc.id, &doc.text)?;  // Checks every call
}
    ]]></before>

    <after><![CDATA[
// New API (validated once at load)
let (texts, ids) = load_custom_corpus_bounded("data.txt", None)?;
let mut pipeline = DedupPipeline::new(texts.len(), &cpu_caps);

for (id, text) in ids.into_iter().zip(texts) {
    pipeline.add_document_bounded(id, &text)?;  // Type-safe, no checks
}
    ]]></after>
  </example>

  <example name="Error Handling">
    <code><![CDATA[
use kindly_dedup::bounded_docid::{DocumentIdAllocator, BoundsError};

let allocator = DocumentIdAllocator::new(100);

match allocator.validate(150) {
    Ok(id) => {
        // ID is guaranteed in-bounds
        pipeline.add_document_bounded(id, text)?;
    }
    Err(BoundsError::OutOfBounds { id, capacity }) => {
        eprintln!("Invalid ID {}: exceeds capacity {}", id, capacity);
    }
}
    ]]></code>
  </example>
</usage-examples>

