<performance>
  <zero-cost-proof>
    <assembly-comparison>
      <before><![CDATA[
; add_document(usize, ...)
    cmp rsi, [rdi+16]      ; CHECK 1: doc_id >= num_documents
    jae .bounds_error
    cmp rsi, [rdi+24]      ; CHECK 2: doc_id >= signatures.len()
    jae .bounds_error
    mov rax, [rdi + rsi*8] ; Index signatures[doc_id]
      ]]></before>

      <after><![CDATA[
; add_document_bounded(DocumentId, ...)
    ; No bounds checks!
    mov rax, [rdi + rsi*8] ; Index signatures[doc_id.as_usize()]
      ]]></after>

      <saved-instructions>2 comparisons + 2 conditional jumps = ~2-3ns per call</saved-instructions>
