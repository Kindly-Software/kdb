  <breaking-changes version="0.6.0">
    <summary>ConcurrentMapCapsule key storage fix (race condition), ObfuscationCapsule production-ready, AnomalyDetector HLL improvements</summary>
    <migration-time>1-2 hours (type signature updates)</migration-time>

    <change priority="P0">
      <name>ConcurrentMapCapsule MapEntry Key Storage (Race Condition Fix)</name>
      <impact>BREAKING - MapEntry&lt;V&gt; → MapEntry&lt;K, V&gt; (adds key storage for proper comparison)</impact>
      <reason>Fix race condition where concurrent or_insert_with() created duplicate keys (hash-only comparison allowed hash collisions)</reason>
      <action>
        Old: MapEntry&lt;V&gt; only stored value pointer
        New: MapEntry&lt;K, V&gt; stores both key and value pointers for true key comparison
      </action>
      <test-impact>test_concurrent_or_insert_with now passes (50 keys, not 54)</test-impact>
      <performance>+10ns insert (key allocation), &lt;10% overhead (marginal)</performance>
      <benefit>100% correct duplicate prevention, hash collision detection, production-ready concurrent or_insert_with</benefit>
    </change>

    <change priority="P0">
      <name>Automatic Verification Default (Verification v0.4.0)</name>
      <impact>BREAKING - All capsules MUST use #[derive(ComputationalCapsule)] or #[capsule(...)] attributes</impact>
      <reason>Complete deprecation of manual verification macros (verify_capsule_properties!, verify_alignment_only!)</reason>
      <action>
        Old: #[repr(C, align(64))] struct MyCapule { ... } with verify_capsule_properties!(...);
        New: #[derive(ComputationalCapsule)] #[capsule(alignment = 64, size = 64)] #[repr(C, align(64))] struct MyCapsule { ... }
      </action>
      <deadline>v0.5.0 (Q1 2026) - Manual macros marked deprecated</deadline>
      <benefit>0ns runtime cost, 100% compile-time verification, 87.5% code reduction in verification layer</benefit>
    </change>

