/// ```rust,ignore
/// use atomic_capsule::encoder::PsychovisualCapsule;
///
/// let psy = PsychovisualCapsule::new();
///
/// // Configure QPA strength (0-100, default 50)
/// psy.set_qpa_strength(50);
///
