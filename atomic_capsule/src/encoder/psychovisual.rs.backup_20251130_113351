use core::sync::atomic::{AtomicU64, Ordering};
use core::mem::size_of;

/// Q8.8 fixed-point type (8 integer bits, 8 fractional bits)
/// Range: -128.0 to +127.996 (precision: 1/256 ≈ 0.00390625)
pub type Q8_8 = u16;

/// Q16.16 fixed-point type (16 integer bits, 16 fractional bits)
/// Range: -32768 to +32767.99998 (precision: 1/65536 ≈ 0.0000152587890625)
pub type Q16_16 = u32;

/// Convert f32 to Q8.8 fixed-point
#[inline]
const fn f32_to_q8_8(value: f32) -> Q8_8 {
    (value * 256.0) as u16
}

/// Convert Q8.8 fixed-point to f32
#[inline]
const fn q8_8_to_f32(value: Q8_8) -> f32 {
    (value as f32) / 256.0
}

/// Convert f32 to Q16.16 fixed-point
#[inline]
const fn f32_to_q16_16(value: f32) -> Q16_16 {
    (value * 65536.0) as u32
}

/// Convert Q16.16 fixed-point to f32
#[inline]
const fn q16_16_to_f32(value: Q16_16) -> f32 {
    (value as f32) / 65536.0
}

