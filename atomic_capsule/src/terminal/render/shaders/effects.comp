#version 450

layout(local_size_x = 8, local_size_y = 8, local_size_z = 1) in;

// Input/output images
layout(set = 0, binding = 0, rgba8) uniform readonly image2D i_input;
layout(set = 0, binding = 1, rgba8) uniform writeonly image2D o_output;

// Effect uniforms
layout(set = 0, binding = 2) uniform EffectUniforms {
    uint u_enabled_flags;
    float u_time;
    uint u_frame;
    uint _pad0;
    vec4 u_crt;      // scanline, curvature, phosphor, _pad
    vec4 u_bloom;    // threshold, intensity, radius, _pad
    vec4 u_color;    // gamma, contrast, saturation, temperature
    vec4 u_vignette; // intensity, radius, _pad, _pad
    vec4 u_chroma;   // r_offset, g_offset, b_offset, _pad
};

// Effect flags (must match Rust EffectFlags)
const uint EFFECT_CRT_SCANLINES = 1u;
const uint EFFECT_CRT_CURVATURE = 2u;
const uint EFFECT_CRT_PHOSPHOR = 4u;
const uint EFFECT_BLOOM = 8u;
const uint EFFECT_CHROMATIC_ABERRATION = 16u;
const uint EFFECT_VIGNETTE = 32u;
const uint EFFECT_NOISE = 64u;
const uint EFFECT_COLOR_GRADING = 128u;

// Hash function for noise
float hash(vec2 p) {
    p = fract(p * vec2(123.34, 456.21));
    p += dot(p, p + 45.32);
    return fract(p.x * p.y);
}

// Random noise
float noise(vec2 uv, float time) {
    return hash(uv + vec2(time, -time)) * 2.0 - 1.0;
}

// CRT scanlines effect
vec3 apply_scanlines(vec3 color, vec2 uv, float intensity, float time) {
    float scanline = sin(uv.y * 3.14159 * 800.0 + time * 10.0) * 0.5 + 0.5;
    scanline = mix(1.0, scanline, 0.5); // Soften the effect
    return color * mix(1.0, scanline, intensity);
}

// CRT curvature distortion
vec2 apply_curvature(vec2 uv, float amount) {
    uv = uv * 2.0 - 1.0;
    vec2 offset = abs(uv.yx) / vec2(amount, amount);
    uv = uv + uv * offset * offset;
    uv = uv * 0.5 + 0.5;
    return uv;
}

// Phosphor persistence (RGB subpixel trails)
vec3 apply_phosphor(vec3 color, float intensity) {
    // Simulate RGB phosphor decay at different rates
    vec3 decay = vec3(0.98, 0.95, 0.92); // R decays slowest
    return color * mix(vec3(1.0), decay, intensity);
}

// Vignette effect
vec3 apply_vignette(vec3 color, vec2 uv, float intensity, float radius) {
    vec2 center = uv - 0.5;
    float dist = length(center);
    float vignette = smoothstep(radius, radius - 0.5, dist);
    return color * mix(1.0, vignette, intensity);
}

// Bloom effect (simple approximation)
vec3 apply_bloom(vec3 color, float threshold, float intensity) {
    vec3 bright = max(color - threshold, vec3(0.0));
    return color + bright * intensity;
}

// Chromatic aberration
vec3 apply_chromatic_aberration(ivec2 pixel, ivec2 size, vec3 offsets) {
    vec2 center = vec2(size) * 0.5;
    vec2 dir = (vec2(pixel) - center) / vec2(size);
    float dist = length(dir);

    ivec2 r_pixel = pixel + ivec2(dir * offsets.r * dist * 10.0);
    ivec2 g_pixel = pixel + ivec2(dir * offsets.g * dist * 10.0);
    ivec2 b_pixel = pixel + ivec2(dir * offsets.b * dist * 10.0);

    vec3 color;
    color.r = imageLoad(i_input, clamp(r_pixel, ivec2(0), size - 1)).r;
    color.g = imageLoad(i_input, clamp(g_pixel, ivec2(0), size - 1)).g;
    color.b = imageLoad(i_input, clamp(b_pixel, ivec2(0), size - 1)).b;

    return color;
}

// Color grading (gamma, contrast, saturation)
vec3 apply_color_grading(vec3 color, vec4 params) {
    float gamma = params.x;
    float contrast = params.y;
    float saturation = params.z;

    // Gamma correction
    color = pow(color, vec3(1.0 / gamma));

    // Contrast
    color = (color - 0.5) * contrast + 0.5;

    // Saturation
    float luma = dot(color, vec3(0.299, 0.587, 0.114));
    color = mix(vec3(luma), color, saturation);

    return clamp(color, 0.0, 1.0);
}

void main() {
    ivec2 pixel = ivec2(gl_GlobalInvocationID.xy);
    ivec2 size = imageSize(i_input);

    if (pixel.x >= size.x || pixel.y >= size.y) return;

    vec2 uv = vec2(pixel) / vec2(size);
    vec4 color;

    // Apply chromatic aberration first (reads from input image)
    if ((u_enabled_flags & EFFECT_CHROMATIC_ABERRATION) != 0u) {
        color.rgb = apply_chromatic_aberration(pixel, size, u_chroma.rgb);
        color.a = imageLoad(i_input, pixel).a;
    } else {
        color = imageLoad(i_input, pixel);
    }

    // Apply CRT curvature
    if ((u_enabled_flags & EFFECT_CRT_CURVATURE) != 0u) {
        vec2 curved_uv = apply_curvature(uv, u_crt.y);
        // Check if outside curved bounds
        if (curved_uv.x < 0.0 || curved_uv.x > 1.0 || curved_uv.y < 0.0 || curved_uv.y > 1.0) {
            color = vec4(0.0, 0.0, 0.0, 1.0);
        } else {
            uv = curved_uv;
        }
    }

    // Apply CRT scanlines
    if ((u_enabled_flags & EFFECT_CRT_SCANLINES) != 0u) {
        color.rgb = apply_scanlines(color.rgb, uv, u_crt.x, u_time);
    }

    // Apply phosphor persistence
    if ((u_enabled_flags & EFFECT_CRT_PHOSPHOR) != 0u) {
        color.rgb = apply_phosphor(color.rgb, u_crt.z);
    }

    // Apply bloom
    if ((u_enabled_flags & EFFECT_BLOOM) != 0u) {
        color.rgb = apply_bloom(color.rgb, u_bloom.x, u_bloom.y);
    }

    // Apply vignette
    if ((u_enabled_flags & EFFECT_VIGNETTE) != 0u) {
        color.rgb = apply_vignette(color.rgb, uv, u_vignette.x, u_vignette.y);
    }

    // Apply noise
    if ((u_enabled_flags & EFFECT_NOISE) != 0u) {
        float n = noise(uv, u_time) * 0.05;
        color.rgb += n;
    }

    // Apply color grading (gamma, contrast, saturation)
    if ((u_enabled_flags & EFFECT_COLOR_GRADING) != 0u) {
        color.rgb = apply_color_grading(color.rgb, u_color);
    }

    // Ensure alpha is preserved
    color.rgb = clamp(color.rgb, 0.0, 1.0);

    imageStore(o_output, pixel, color);
}
