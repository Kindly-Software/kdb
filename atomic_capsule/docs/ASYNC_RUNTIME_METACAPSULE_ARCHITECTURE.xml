        <field name="generation">4B</field>
        <field name="future_ptr">8B</field>
        <field name="waker_ptr">8B</field>
        <field name="user_data">8B</field>
        <field name="padding">32B</field>
      </breakdown>
    </memory>
  </performance-targets>

  <!-- ============================================================================
       ASSUM SAFETY TAGS
       ============================================================================ -->
  <assum-safety target="99.99%">
    <category name="Memory Ordering">
      <tag id="ASSUME_ACQUIRE_RELEASE" verify="All cross-thread reads use Acquire, writes use Release">
        Pattern: load(Acquire) / store(Release) / compare_exchange(AcqRel, Acquire)
      </tag>
      <tag id="ASSUME_RELAXED_STATS" verify="Statistics counters can use Relaxed (approximate is OK)">
        Pattern: fetch_add(Relaxed) for non-critical counters
      </tag>
    </category>

    <category name="ABA Prevention">
      <tag id="ASSUME_GENERATION_MONOTONIC" verify="Generation counters never decrease">
        Pattern: wrapping_add(1) on slot release
      </tag>
      <tag id="ASSUME_SLOT_REUSE_SAFE" verify="Generation mismatch detected before slot access">
        Pattern: Load generation, verify match, then access data
      </tag>
    </category>

    <category name="Pointer Safety">
      <tag id="ASSUME_FUTURE_PTR_VALID" verify="Future pointer valid while task in Running state">
        Pattern: State machine prevents double-free
      </tag>
      <tag id="ASSUME_WAKER_PTR_VALID" verify="Waker pointer valid until task completion">
        Pattern: Clear waker before slot release
      </tag>
      <tag id="ASSUME_SUBCAPSULE_LIFETIME" verify="Sub-capsules outlive metacapsule">
        Pattern: Box allocation, never freed during runtime
      </tag>
    </category>

    <category name="Lockfree Correctness">
      <tag id="ASSUME_CAS_CONVERGENCE" verify="CAS loops converge under contention">
        Pattern: Bounded retry with backoff
      </tag>
      <tag id="ASSUME_NO_LIVELOCK" verify="Progress guaranteed even under high contention">
        Pattern: Work-stealing prevents starvation
      </tag>
    </category>

    <category name="Thread Safety">
      <tag id="ASSUME_SEND_SYNC" verify="All capsules implement Send + Sync">
        Pattern: Only atomic fields, no interior mutability without UnsafeCell
      </tag>
      <tag id="ASSUME_NO_DATA_RACE" verify="All shared state protected by atomics">
        Pattern: No raw pointer races, generation counters validate access
      </tag>
    </category>
  </assum-safety>

