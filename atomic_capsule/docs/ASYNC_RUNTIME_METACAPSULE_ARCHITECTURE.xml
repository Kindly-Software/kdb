<?xml version="1.0" encoding="UTF-8"?>
<!--
  AsyncRuntimeMetacapsule Architecture Design
  UCE34 T6 Mixed Tier (T1+T4+T5) - Tokio Replacement
  Version: 1.0.0
  Date: 2025-11-24

  Framework Compliance: UCE34 (Q1-Q34), Chaos (100% lockfree), ASSUM (99.99%), B32 (fair), T28 (5-tier), I20 (20/20)
-->
<async-runtime-metacapsule version="1.0.0">

  <meta>
    <name>AsyncRuntimeMetacapsule</name>
    <tier>T6 Mixed (T1 Atomic + T4 Batch + T5 Streaming)</tier>
    <size>512 bytes</size>
    <alignment>128 bytes</alignment>
    <purpose>100% lockfree async runtime replacing Tokio with 5-10x speedup on high-core systems</purpose>
    <status>Design Phase</status>
  </meta>

  <!-- ============================================================================
       EXECUTIVE SUMMARY
       ============================================================================ -->
  <executive-summary>
    <goal>Replace Tokio async runtime with 100% lockfree capsule architecture</goal>
    <approach>T6 Mixed metacapsule orchestrating T1 reactor, T4 work-stealing, T5 event pipeline</approach>
    <speedup-target>5-10x vs Tokio on high-core systems (16+ cores)</speedup-target>
    <latency-target>spawn: &lt;100ns | wakeup: &lt;50ns | poll: &lt;200ns | switch: &lt;500ns</latency-target>
    <memory-target>512B orchestrator + 64KB task slots (1024 tasks @ 64B each)</memory-target>
    <design-principle>Zero mutex/RwLock, cache-aligned, generation counters, DualAtomicU64</design-principle>
  </executive-summary>

  <!-- ============================================================================
       PROBLEM ANALYSIS
       ============================================================================ -->
  <problem-analysis>
    <tokio-limitations>
      <limitation id="1">Mutex contention in work-stealing queue (100-500ns overhead)</limitation>
      <limitation id="2">Arc/Weak reference counting overhead (50-100ns per clone)</limitation>
      <limitation id="3">Channel-based task notification (200-500ns per wakeup)</limitation>
      <limitation id="4">Complex scheduler state machine (1-5us context switch)</limitation>
      <limitation id="5">Non-deterministic task ordering (poor for real-time)</limitation>
    </tokio-limitations>

    <existing-gaps>
      <gap id="1" file="executor.rs">ExecutorCapsule.spawn() creates new Arc instead of storing task</gap>
      <gap id="2" file="executor.rs">No WorkStealingQueue integration despite documentation</gap>
      <gap id="3" file="executor.rs">Waker pattern incomplete (ExecutorWaker unused)</gap>
      <gap id="4" file="event_queue.rs">EventQueueCapsule lacks task-to-waker mapping</gap>
      <gap id="5" file="reactor/mod.rs">ReactorCapsule not connected to executor</gap>
    </existing-gaps>

    <design-constraints>
      <constraint id="1" priority="CRITICAL">Zero mutex/RwLock (Chaos mandate)</constraint>
      <constraint id="2" priority="CRITICAL">Cache-aligned capsules (64B/128B)</constraint>
      <constraint id="3" priority="CRITICAL">Generation counters for ABA prevention</constraint>
      <constraint id="4" priority="HIGH">DualAtomicU64 for state + metadata packing</constraint>
      <constraint id="5" priority="HIGH">Compile-time verification via #[derive(ComputationalCapsule)]</constraint>
    </design-constraints>
  </problem-analysis>

  <!-- ============================================================================
       ARCHITECTURE OVERVIEW
       ============================================================================ -->
  <architecture topology="pipeline">
    <description>
      Metacapsule orchestrates 5 sub-capsules in a producer-consumer pipeline:

      [Spawn API] --> [TaskSlotPoolCapsule] --> [WorkStealingQueueCapsule]
                                                        |
      [ReactorCoordinatorCapsule] <-- [WakerRegistryCapsule]
                                                        |
      [EventPipelineCapsule] <-- [I/O Events, Timers, Signals]
    </description>

    <sub-capsules count="5">
      <capsule id="1" name="TaskSlotPoolCapsule" tier="T1" size="64KB">
        <purpose>Pre-allocated task storage with lockfree slot management</purpose>
        <pattern>T1 Atomic slot pool (generation counters, ABA prevention)</pattern>
        <capacity>1024 tasks @ 64B each</capacity>
        <operations>
          <op name="acquire_slot">&lt;50ns (atomic fetch-add + generation check)</op>
          <op name="release_slot">&lt;30ns (atomic store + generation bump)</op>
        </operations>
      </capsule>

      <capsule id="2" name="WorkStealingQueueCapsule" tier="T4" size="4KB">
        <purpose>NUMA-aware work distribution across worker threads</purpose>
        <pattern>T4 Batch (lockfree deques, chase-lev algorithm)</pattern>
        <capacity>256 tasks per worker, 16 workers max</capacity>
        <operations>
          <op name="push_local">&lt;50ns (local deque, no contention)</op>
          <op name="pop_local">&lt;30ns (local deque pop)</op>
          <op name="steal_remote">&lt;100ns (cross-thread CAS)</op>
        </operations>
      </capsule>

      <capsule id="3" name="WakerRegistryCapsule" tier="T1" size="2KB">
        <purpose>Task ID to waker mapping for async notification</purpose>
        <pattern>T1 Atomic hash table (lockfree, generation counters)</pattern>
        <capacity>1024 wakers</capacity>
        <operations>
          <op name="register_waker">&lt;50ns (hash + CAS insert)</op>
          <op name="lookup_waker">&lt;30ns (hash + atomic load)</op>
          <op name="notify_waker">&lt;50ns (lookup + event queue push)</op>
        </operations>
      </capsule>

      <capsule id="4" name="ReactorCoordinatorCapsule" tier="T1" size="256B">
        <purpose>Coordinate reactor events with executor wakeups</purpose>
        <pattern>T1 Atomic (DualAtomicU64 state + event counter)</pattern>
        <integrates>ReactorCapsule (epoll/kqueue), IoUringCapsule (Linux)</integrates>
        <operations>
          <op name="dispatch_event">&lt;100ns (event type decode + waker notify)</op>
          <op name="register_interest">&lt;50ns (fd to task mapping)</op>
        </operations>
      </capsule>

      <capsule id="5" name="EventPipelineCapsule" tier="T5" size="8KB">
        <purpose>Streaming I/O event processing with O(1) overhead</purpose>
        <pattern>T5 Streaming (ring buffer, incremental processing)</pattern>
        <capacity>4096 events (16B each)</capacity>
        <operations>
          <op name="enqueue_event">&lt;30ns (ring append)</op>
          <op name="process_batch">&lt;500ns per 10 events</op>
        </operations>
      </capsule>
    </sub-capsules>

    <orchestrator name="AsyncRuntimeMetacapsule" tier="T6" size="512B">
      <purpose>Coordinate all sub-capsules with lockfree state machine</purpose>
      <layout>
        <field offset="0-7" name="state" type="DualAtomicU64">Phase (3 bits) + Generation (29 bits) + Worker count (8 bits) + Pending tasks (24 bits)</field>
        <field offset="8-15" name="stats_packed" type="DualAtomicU64">Total spawned (32 bits) + Total completed (32 bits)</field>
        <field offset="16-23" name="task_pool_ptr" type="AtomicU64">Pointer to TaskSlotPoolCapsule</field>
        <field offset="24-31" name="work_queue_ptr" type="AtomicU64">Pointer to WorkStealingQueueCapsule</field>
        <field offset="32-39" name="waker_registry_ptr" type="AtomicU64">Pointer to WakerRegistryCapsule</field>
        <field offset="40-47" name="reactor_ptr" type="AtomicU64">Pointer to ReactorCoordinatorCapsule</field>
        <field offset="48-55" name="event_pipeline_ptr" type="AtomicU64">Pointer to EventPipelineCapsule</field>
        <field offset="56-63" name="config" type="AtomicU64">NUMA nodes (4 bits) + Workers per node (4 bits) + Flags (56 bits)</field>
        <field offset="64-127" name="_padding_hot" type="[u8; 64]">Cache line separation</field>
        <field offset="128-511" name="_padding_cold" type="[u8; 384]">Cold stats, rarely accessed</field>
      </layout>
      <state-machine>
        <state id="0" name="Uninitialized">No sub-capsules allocated</state>
        <state id="1" name="Initializing">Allocating sub-capsules</state>
        <state id="2" name="Ready">All sub-capsules initialized, workers not started</state>
        <state id="3" name="Running">Workers active, accepting tasks</state>
        <state id="4" name="Draining">No new tasks, completing pending</state>
        <state id="5" name="Shutdown">Workers stopped, cleanup in progress</state>
        <state id="6" name="Terminated">All resources released</state>
      </state-machine>
    </orchestrator>
  </architecture>

  <!-- ============================================================================
       UCE34 TIER JUSTIFICATION (Q10-Q12)
       ============================================================================ -->
  <tier-justification>
    <q10-tier-selection>
      <tier name="T1 Atomic" justification="TaskSlotPool, WakerRegistry, ReactorCoordinator require &lt;100ns atomic coordination">
        <use-case>Slot acquisition, waker registration, event dispatch</use-case>
        <pattern>DualAtomicU64, generation counters, CAS operations</pattern>
        <speedup>3-10x vs mutex-based (Tokio uses parking_lot mutexes)</speedup>
      </tier>
      <tier name="T4 Batch" justification="WorkStealingQueue enables 10-100x batch processing">
        <use-case>Task distribution, NUMA-aware scheduling, parallel execution</use-case>
        <pattern>Chase-Lev deques, batch steal, thread affinity</pattern>
        <speedup>10-50x vs single-queue (amortized over batch size)</speedup>
      </tier>
      <tier name="T5 Streaming" justification="EventPipeline provides O(1) incremental processing">
        <use-case>I/O event handling, timer wheel ticks, signal processing</use-case>
        <pattern>Ring buffer, streaming append, batch harvest</pattern>
        <speedup>2-5x vs allocation-per-event (Tokio channels allocate)</speedup>
      </tier>
      <tier name="T6 Mixed" justification="Compound speedup from T1+T4+T5 integration">
        <compound-effect>5-10x total (T1 coordination + T4 parallelism + T5 I/O)</compound-effect>
        <metacapsule-benefit>Lockfree orchestration, atomic state snapshot, deterministic transitions</metacapsule-benefit>
      </tier>
    </q10-tier-selection>

    <q11-rust-evaluation>
      <feature name="AtomicU64/AtomicPtr" usage="All capsule coordination" reason="100% lockfree"/>
      <feature name="DualAtomicU64" usage="State + metadata packing" reason="Single atomic load for multiple fields"/>
      <feature name="Box/Arc" usage="MINIMAL - only sub-capsule allocation" reason="Avoid per-task allocation"/>
      <feature name="UnsafeCell" usage="TaskSlotPool interior mutability" reason="Required for lockfree slot reuse"/>
    </q11-rust-evaluation>

    <q12-nightly-evaluation>
      <feature name="portable_simd" usage="NOT REQUIRED" reason="No SIMD in hot paths"/>
      <feature name="const_fn_floating_point" usage="NOT REQUIRED" reason="No floating-point in runtime"/>
      <feature name="atomic_from_mut" usage="OPTIONAL" reason="Could optimize TaskSlot initialization"/>
      <feature name="generic_const_exprs" usage="OPTIONAL" reason="Could enable compile-time capacity validation"/>
    </q12-nightly-evaluation>
  </tier-justification>

  <!-- ============================================================================
       IMPLEMENTATION PLAN
       ============================================================================ -->
  <implementation-plan>
    <phase id="1" name="Task Storage Foundation" files="2" hours="4">
      <file path="src/runtime/task_slot_pool.rs" lines="~400">
        TaskSlotPoolCapsule: Pre-allocated lockfree slot pool for task storage.
        - 1024 slots @ 64B each (64KB total)
        - Generation counters for ABA prevention
        - Free list via AtomicU32 bitfield
        - &lt;50ns acquire, &lt;30ns release
      </file>
      <file path="src/runtime/task_slot.rs" lines="~150">
        TaskSlot: Individual task container (64B cache-aligned).
        - state: AtomicU32 (Free=0, Allocated=1, Running=2, Completed=3)
        - generation: AtomicU32 (ABA prevention)
        - future_ptr: AtomicU64 (type-erased future pointer)
        - waker_ptr: AtomicU64 (registered waker)
      </file>
      <deliverable>TaskSlotPoolCapsule with 28 T28 tests</deliverable>
    </phase>

    <phase id="2" name="Work-Stealing Queue" files="2" hours="6">
      <file path="src/runtime/work_stealing_queue.rs" lines="~600">
        WorkStealingQueueCapsule: NUMA-aware lockfree task distribution.
        - Chase-Lev algorithm for local/steal operations
        - Per-worker deques (256 tasks each)
        - NUMA topology detection
        - Batch steal for efficiency
      </file>
      <file path="src/runtime/worker_deque.rs" lines="~300">
        WorkerDeque: Individual worker's task deque.
        - Lockfree push/pop for local access
        - Lockfree steal for remote access
        - Generation counters for ABA prevention
      </file>
      <deliverable>WorkStealingQueueCapsule with 28 T28 tests</deliverable>
    </phase>

    <phase id="3" name="Waker Integration" files="1" hours="3">
      <file path="src/runtime/waker_registry.rs" lines="~350">
        WakerRegistryCapsule: Task ID to waker mapping.
        - Lockfree hash table (ConcurrentMapCapsule based)
        - Custom RawWaker implementation
        - Generation-aware waker invalidation
        - Integration with EventPipeline
      </file>
      <deliverable>WakerRegistryCapsule with 28 T28 tests</deliverable>
    </phase>

    <phase id="4" name="Reactor Coordinator" files="1" hours="3">
      <file path="src/runtime/reactor_coordinator.rs" lines="~400">
        ReactorCoordinatorCapsule: Bridge reactor events to executor.
        - FD-to-TaskID mapping
        - Event dispatch to WakerRegistry
        - Integration with existing ReactorCapsule
        - Support for epoll/kqueue/io_uring
      </file>
      <deliverable>ReactorCoordinatorCapsule with 28 T28 tests</deliverable>
    </phase>

    <phase id="5" name="Event Pipeline" files="1" hours="2">
      <file path="src/runtime/event_pipeline.rs" lines="~300">
        EventPipelineCapsule: Streaming event processing.
        - Ring buffer (4096 events @ 16B)
        - Batch processing (10 events per iteration)
        - Priority support (high/normal/low)
        - Overflow handling
      </file>
      <deliverable>EventPipelineCapsule with 28 T28 tests</deliverable>
    </phase>

    <phase id="6" name="Metacapsule Orchestrator" files="2" hours="6">
      <file path="src/runtime/async_runtime_metacapsule.rs" lines="~800">
        AsyncRuntimeMetacapsule: T6 Mixed orchestrator.
        - State machine (7 phases)
        - Sub-capsule lifecycle management
        - spawn()/block_on() public API
        - Statistics and monitoring
      </file>
      <file path="src/runtime/runtime_builder.rs" lines="~200">
        RuntimeBuilder: Fluent API for runtime configuration.
        - Worker count configuration
        - NUMA binding options
        - Feature toggles (io_uring, kqueue, etc.)
      </file>
      <deliverable>AsyncRuntimeMetacapsule with 56 T28 tests (comprehensive)</deliverable>
    </phase>

    <total estimate="24 hours" files="9" lines="~3000"/>
  </implementation-plan>

  <!-- ============================================================================
       PERFORMANCE TARGETS (B32 Framework)
       ============================================================================ -->
  <performance-targets baseline="Tokio 1.40">
    <operation name="spawn" target="&lt;100ns" baseline="200-500ns" speedup="2-5x">
      <breakdown>
        <step name="slot_acquire">~30ns (atomic CAS)</step>
        <step name="future_store">~20ns (pointer write)</step>
        <step name="queue_push">~50ns (local deque push)</step>
      </breakdown>
    </operation>

    <operation name="wakeup" target="&lt;50ns" baseline="200-500ns" speedup="4-10x">
      <breakdown>
        <step name="waker_lookup">~20ns (hash + load)</step>
        <step name="event_enqueue">~30ns (ring append)</step>
      </breakdown>
    </operation>

    <operation name="poll_once" target="&lt;200ns" baseline="500-1000ns" speedup="2.5-5x">
      <breakdown>
        <step name="dequeue_task">~30ns (local pop)</step>
        <step name="context_setup">~50ns (waker creation)</step>
        <step name="future_poll">~100ns (application code)</step>
        <step name="state_update">~20ns (atomic store)</step>
