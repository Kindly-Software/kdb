  <!-- ============================================================================
       MIGRATION GUIDE
       ============================================================================ -->
  <migration-guide>
    <from>serde + serde_json/bincode</from>
    <to>CapsuleSerialize + CapsuleDeserialize</to>

    <steps>
      <step id="1">
        <title>Add derive macro crate</title>
        <before>
          <![CDATA[
[dependencies]
serde = { version = "1.0", features = ["derive"] }
serde_json = "1.0"
          ]]>
        </before>
        <after>
          <![CDATA[
[dependencies]
atomic_capsule = { version = "0.8", features = ["capsule-serialize"] }
atomic_capsule_derive_serialize = "0.1"
          ]]>
        </after>
      </step>

      <step id="2">
        <title>Replace derive attributes</title>
        <before>
          <![CDATA[
#[derive(Serialize, Deserialize)]
struct Payment {
    amount: f64,
    fee: f64,
}
          ]]>
        </before>
        <after>
          <![CDATA[
#[derive(CapsuleSerialize, CapsuleDeserialize)]
#[repr(C, align(128))]
struct Payment {
    amount: Q16_16,
    fee: Q16_16,
}
          ]]>
        </after>
      </step>

      <step id="3">
        <title>Update serialization calls</title>
        <before>
          <![CDATA[
let json = serde_json::to_string(&payment)?;
let restored: Payment = serde_json::from_str(&json)?;
          ]]>
        </before>
        <after>
          <![CDATA[
let binary = payment.serialize();
let restored = Payment::deserialize(&binary)?;
          ]]>
        </after>
      </step>

      <step id="4">
        <title>Add Q34 audit trail (optional)</title>
        <code>
          <![CDATA[
#[derive(CapsuleSerialize, CapsuleDeserialize)]
#[capsule_serialize(auto_crc = true)]
#[repr(C, align(128))]
struct Payment {
    amount: Q16_16,
    fee: Q16_16,

    #[capsule_serialize(prev_hash)]
    prev_hash: u64,
}

// Verify chain integrity
let is_valid = current.verify_chain(&previous);
          ]]>
        </code>
      </step>
    </steps>

    <benefits>
      <benefit>5-20x faster serialization (compile-time vs runtime)</benefit>
      <benefit>Zero-copy deserialization (borrow from buffer)</benefit>
      <benefit>Deterministic binary format (no floating-point drift)</benefit>
      <benefit>Q34 audit compliance (hash-chain integrity)</benefit>
      <benefit>100% lockfree (no mutex contention)</benefit>
    </benefits>

    <limitations>
      <limitation>Requires #[repr(C, align(N))] on structs</limitation>
      <limitation>Fixed-point types only (Q8_8, Q16_16, Q32_32)</limitation>
      <limitation>No nested struct support (flatten manually)</limitation>
      <limitation>CBOR/JSON formats require optional feature flags</limitation>
    </limitations>
  </migration-guide>

