  <!-- ============================================================================
       MIGRATION GUIDE
       ============================================================================ -->
  <migration-guide>
    <step id="1" title="Add dependency">
      <code>
[dependencies]
atomic_capsule = { version = "0.8", features = ["parallel"] }
      </code>
    </step>

    <step id="2" title="Change imports">
      <before>use rayon::prelude::*;</before>
      <after>use atomic_capsule::parallel::prelude::*;</after>
    </step>

    <step id="3" title="Use identical API">
      <note>
        All common methods work identically:
        - par_iter(), into_par_iter()
        - for_each(), map(), filter(), reduce()
        - find(), partition()
        - with_chunk_size()
      </note>
    </step>

    <step id="4" title="Handle edge cases">
      <note>
        Minor differences:
        - Bounded queues: May return Err(QueueFull) under extreme load
        - Deterministic memory: Fixed 128KB per queue vs Rayon unbounded
        - Cold start: 10x faster (100ns vs 1us)
      </note>
    </step>

    <step id="5" title="Verify with tests">
      <code>
cargo test --features "parallel"
cargo bench --bench hybrid_batch_pool_bench
      </code>
    </step>
  </migration-guide>

  <!-- ============================================================================
       KNOWN LIMITATIONS
       ============================================================================ -->
  <limitations>
    <limitation id="1" severity="Low">
      <description>Bounded queue capacity (2048 per queue)</description>
      <impact>QueueFull error if all queues saturated</impact>
      <mitigation>Increase num_queues for high-throughput workloads</mitigation>
    </limitation>

    <limitation id="2" severity="Low">
      <description>No par_bridge() for arbitrary iterators</description>
      <impact>Must use slice/vec as source</impact>
      <mitigation>Collect to Vec first, or implement custom adapter</mitigation>
    </limitation>

    <limitation id="3" severity="Minimal">
      <description>Thread-local batch not flushed on thread exit</description>
      <impact>Last few tasks delayed until next flush</impact>
      <mitigation>Always call wait() after submitting tasks</mitigation>
    </limitation>
  </limitations>

