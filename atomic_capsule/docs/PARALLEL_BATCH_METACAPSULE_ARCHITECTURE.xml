      <p95>~25us</p95>
      <p99>~35us</p99>
      <p999>~50us</p999>
    </latency-percentiles>

    <scaling-efficiency>
      <thread-count range="1-256">95%+ linear scaling</thread-count>
      <bottleneck>Queue striping (8 queues) limits beyond 64 threads</bottleneck>
