<!-- av1-encoder-metacapsule-api.xml: Av1EncoderMetacapsule API Specification -->
<!-- Version 1.0.0: T6 Mixed tier metacapsule orchestrating 18 AV1 encoder sub-capsules -->
<!-- [TRADE SECRET] World's first 100% lockfree AV1 encoder orchestration -->
<capsule-api xmlns="http://kindly.ai/uce34/v6.0"
             name="Av1EncoderMetacapsule"
             tier="T6"
             size="1024B"
             alignment="64B">

  <!-- ========================================
       METADATA
       ======================================== -->
  <metadata>
    <version>1.0.0</version>
    <status>Stable</status>
    <since>atomic_capsule 0.6.0</since>
    <authors>Kindly Team</authors>
    <location>atomic_capsule::encoder::encoder_metacapsule</location>
