use atomic_capsule::encoder::{Av1EncoderMetacapsule, FrameType};

let encoder = Av1EncoderMetacapsule::new()?;

// Encode I-frame (keyframe)
let encoded = encoder.encode_frame(&amp;frame, FrameType::I)?;
println!("Encoded {} bytes", encoded.data.len());

