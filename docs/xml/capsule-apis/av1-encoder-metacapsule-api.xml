    <example name="streaming_encoding">
      <description>Continuous encoding with flush</description>
      <code language="rust">
use atomic_capsule::encoder::{Av1EncoderMetacapsule, EncoderConfig, FrameType};

let config = EncoderConfig {
    width: 1920,
    height: 1080,
    fps: 30,
    target_bitrate: 5_000_000, // 5 Mbps
    tile_rows: 2,
    tile_cols: 4,
    lookahead_depth: 16,
    ..Default::default()
};
let encoder = Av1EncoderMetacapsule::with_config(config)?;

// Encode frames from source
for frame in frame_source {
    let frame_type = if is_keyframe_interval() { FrameType::I } else { FrameType::P };
    let encoded = encoder.encode_frame(&amp;frame, frame_type)?;
    muxer.write_frame(encoded)?;
}

// Flush remaining frames
for encoded in encoder.flush()? {
    muxer.write_frame(encoded)?;
}
      </code>
