  <!-- ========================================
       METHODS
       ======================================== -->
  <methods>
    <!-- Write operations -->
    <method-group category="write">
      <method name="record">
        <signature>pub fn record(&amp;self, value_ns: u64)</signature>
        <description>Records a latency value in nanoseconds (&lt;10ns operation)</description>
        <thread-safety>MPMC (multiple writers safe, lockfree)</thread-safety>
        <latency>&lt;10ns (atomic increment + bucket calculation)</latency>
        <memory-ordering>Relaxed for bucket increment, AcqRel for min/max CAS</memory-ordering>
        <parameters>
          <param name="value_ns" type="u64">Latency value in nanoseconds (0 to 10s)</param>
        </parameters>
        <preconditions>
          <condition>None (any u64 value accepted)</condition>
        </preconditions>
        <postconditions>
          <condition>Appropriate bucket counter incremented</condition>
          <condition>total_count incremented by 1</condition>
          <condition>min_value_ns updated if value_ns &lt; current min</condition>
          <condition>max_value_ns updated if value_ns &gt; current max</condition>
          <condition>overflow_count incremented if value_ns &gt; MAX_VALUE_NS</condition>
          <condition>generation incremented (triggers cache invalidation)</condition>
        </postconditions>
        <algorithm>
          1. Calculate bucket index: log2(value_ns) * 64 / 64 (approximate)
          2. Clamp to [0, 1023]
          3. Atomic increment bucket[index]
          4. Atomic increment total_count
          5. CAS update min_value_ns (up to 3 retries)
          6. CAS update max_value_ns (up to 3 retries)
          7. Atomic increment generation
        </algorithm>
      </method>

      <method name="reset">
        <signature>pub fn reset(&amp;mut self)</signature>
        <description>Resets all counters to zero (requires mutable reference)</description>
        <thread-safety>Single-threaded (requires &amp;mut self)</thread-safety>
        <latency>O(n) where n = 1024 buckets</latency>
        <memory-ordering>Relaxed (exclusive access via &amp;mut)</memory-ordering>
        <preconditions>
          <condition>Exclusive mutable access</condition>
        </preconditions>
        <postconditions>
          <condition>All 1024 buckets set to 0</condition>
          <condition>total_count = 0</condition>
          <condition>min_value_ns = u64::MAX</condition>
          <condition>max_value_ns = 0</condition>
          <condition>overflow_count = 0</condition>
          <condition>Cached percentiles invalidated</condition>
        </postconditions>
      </method>
    </method-group>

    <!-- Read operations (cached) -->
    <method-group category="read-cached">
      <method name="p50">
        <signature>pub fn p50(&amp;self) -> Option&lt;u64&gt;</signature>
        <description>Returns cached 50th percentile (median) in nanoseconds</description>
        <thread-safety>MPMC</thread-safety>
        <latency>&lt;5ns (atomic load from cache)</latency>
        <memory-ordering>Acquire (synchronize with cache update)</memory-ordering>
        <preconditions>
          <condition>None</condition>
        </preconditions>
        <postconditions>
          <condition>Returns Some(value) if histogram has data</condition>
          <condition>Returns None if total_count == 0</condition>
          <condition>Cache automatically refreshed if stale (generation mismatch)</condition>
        </postconditions>
        <returns>Option&lt;u64&gt; - Median latency in nanoseconds</returns>
      </method>

      <method name="p95">
        <signature>pub fn p95(&amp;self) -> Option&lt;u64&gt;</signature>
        <description>Returns cached 95th percentile in nanoseconds</description>
        <thread-safety>MPMC</thread-safety>
        <latency>&lt;5ns (atomic load from cache)</latency>
        <memory-ordering>Acquire</memory-ordering>
        <preconditions>
          <condition>None</condition>
        </preconditions>
        <postconditions>
          <condition>Returns value where 95% of samples are below</condition>
        </postconditions>
      </method>

      <method name="p99">
        <signature>pub fn p99(&amp;self) -> Option&lt;u64&gt;</signature>
        <description>Returns cached 99th percentile in nanoseconds</description>
        <thread-safety>MPMC</thread-safety>
        <latency>&lt;5ns (atomic load from cache)</latency>
        <memory-ordering>Acquire</memory-ordering>
        <preconditions>
          <condition>None</condition>
        </preconditions>
        <postconditions>
          <condition>Returns value where 99% of samples are below</condition>
        </postconditions>
      </method>

      <method name="p999">
        <signature>pub fn p999(&amp;self) -> Option&lt;u64&gt;</signature>
        <description>Returns cached 99.9th percentile in nanoseconds</description>
        <thread-safety>MPMC</thread-safety>
        <latency>&lt;5ns (atomic load from cache)</latency>
        <memory-ordering>Acquire</memory-ordering>
        <preconditions>
          <condition>None</condition>
        </preconditions>
        <postconditions>
          <condition>Returns value where 99.9% of samples are below</condition>
        </postconditions>
      </method>
    </method-group>

    <!-- Read operations (computed) -->
    <method-group category="read-computed">
      <method name="percentiles">
        <signature>pub fn percentiles(&amp;self) -> PercentileSnapshot</signature>
        <description>Computes fresh percentile snapshot (scans all buckets)</description>
        <thread-safety>MPMC</thread-safety>
        <latency>&lt;1us (1024 bucket scan)</latency>
        <memory-ordering>Acquire (consistent snapshot)</memory-ordering>
        <preconditions>
          <condition>None</condition>
        </preconditions>
        <postconditions>
          <condition>Returns complete snapshot with P50/P95/P99/P999/min/max/count</condition>
          <condition>Updates cached percentiles for future fast access</condition>
        </postconditions>
        <returns>
          PercentileSnapshot {
            p50: u64, p95: u64, p99: u64, p999: u64,
            min: u64, max: u64, count: u64, overflow: u64
          }
        </returns>
        <algorithm>
          1. Scan all 1024 buckets, accumulate counts
          2. Find P50 bucket (50% of total_count)
          3. Find P95 bucket (95% of total_count)
          4. Find P99 bucket (99% of total_count)
          5. Find P999 bucket (99.9% of total_count)
          6. Convert bucket indices to nanosecond values
          7. Update cache atomically
        </algorithm>
      </method>

      <method name="total_count">
        <signature>pub fn total_count(&amp;self) -> u64</signature>
        <description>Returns total number of recorded values</description>
        <thread-safety>MPMC</thread-safety>
        <latency>&lt;5ns (single atomic load)</latency>
        <memory-ordering>Relaxed</memory-ordering>
        <preconditions>
          <condition>None</condition>
        </preconditions>
        <postconditions>
          <condition>Returns count at time of call (may be stale under contention)</condition>
        </postconditions>
      </method>

      <method name="min">
        <signature>pub fn min(&amp;self) -> Option&lt;u64&gt;</signature>
        <description>Returns minimum recorded value in nanoseconds</description>
        <thread-safety>MPMC</thread-safety>
        <latency>&lt;5ns (single atomic load)</latency>
        <memory-ordering>Acquire</memory-ordering>
        <preconditions>
          <condition>None</condition>
        </preconditions>
        <postconditions>
          <condition>Returns Some(min) if total_count &gt; 0</condition>
          <condition>Returns None if histogram is empty</condition>
        </postconditions>
      </method>

      <method name="max">
        <signature>pub fn max(&amp;self) -> Option&lt;u64&gt;</signature>
        <description>Returns maximum recorded value in nanoseconds</description>
        <thread-safety>MPMC</thread-safety>
        <latency>&lt;5ns (single atomic load)</latency>
        <memory-ordering>Acquire</memory-ordering>
        <preconditions>
          <condition>None</condition>
        </preconditions>
        <postconditions>
          <condition>Returns Some(max) if total_count &gt; 0</condition>
          <condition>Returns None if histogram is empty</condition>
        </postconditions>
      </method>

      <method name="overflow_count">
        <signature>pub fn overflow_count(&amp;self) -> u64</signature>
        <description>Returns count of values exceeding 10s (overflow bucket)</description>
        <thread-safety>MPMC</thread-safety>
        <latency>&lt;5ns (single atomic load)</latency>
        <memory-ordering>Relaxed</memory-ordering>
        <preconditions>
          <condition>None</condition>
        </preconditions>
        <postconditions>
          <condition>Returns number of values &gt; MAX_VALUE_NS</condition>
        </postconditions>
      </method>
    </method-group>
  </methods>

  <!-- ========================================
       CONNECTIONS
       ======================================== -->
  <connections>
    <description>How HistogramCapsule connects to other capsules</description>
    <input type="direct" from="HttpServerCapsule">
      <description>Receives request latencies for recording</description>
      <protocol>record(elapsed_ns) after each request</protocol>
    </input>
    <input type="direct" from="CircuitBreaker">
      <description>Records call latencies for circuit breaker protected operations</description>
      <protocol>record() called in try_call() wrapper</protocol>
    </input>
    <output type="poll" to="MetricsCapsule">
      <description>Provides percentile data for metrics export</description>
      <protocol>percentiles() called periodically (e.g., every 10s)</protocol>
    </output>
    <output type="poll" to="ObservabilityCapsule">
      <description>Provides latency data for dashboards</description>
      <protocol>p50/p95/p99/p999() for real-time display</protocol>
    </output>
  </connections>

  <!-- ========================================
       INVARIANTS
       ======================================== -->
  <invariants>
    <invariant id="I1">size_of::&lt;HistogramCapsule&gt;() == 8KB (verified at compile time)</invariant>
    <invariant id="I2">align_of::&lt;HistogramCapsule&gt;() &gt;= 64 (L1 cache line)</invariant>
    <invariant id="I3">sum(buckets[0..1024]) + overflow_count == total_count</invariant>
    <invariant id="I4">min_value_ns &lt;= max_value_ns (when total_count &gt; 0)</invariant>
    <invariant id="I5">Generation counter increases monotonically with each record()</invariant>
    <invariant id="I6">All bucket operations are wait-free (atomic fetch_add)</invariant>
    <invariant id="I7">Bucket boundaries are monotonically increasing (logarithmic scale)</invariant>
  </invariants>

