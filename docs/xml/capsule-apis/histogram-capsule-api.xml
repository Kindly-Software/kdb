  <!-- ========================================
       EXAMPLES
       ======================================== -->
  <examples>
    <example name="basic_usage">
      <description>Recording latencies and querying percentiles</description>
      <code language="rust">
use atomic_capsule::collections::HistogramCapsule;

let histogram = HistogramCapsule::new();

// Record some latencies
histogram.record(1_000_000);  // 1ms
histogram.record(2_000_000);  // 2ms
histogram.record(3_000_000);  // 3ms

// Query cached percentiles
assert_eq!(histogram.p50(), Some(2_000_000));
assert_eq!(histogram.total_count(), 3);
      </code>
    </example>

    <example name="static_histogram">
      <description>Using histogram in static context</description>
      <code language="rust">
use atomic_capsule::collections::HistogramCapsule;

// Global histogram for API latency tracking
static API_LATENCY: HistogramCapsule = HistogramCapsule::new();

fn handle_request() {
    let start = std::time::Instant::now();
    // ... process request ...
    API_LATENCY.record(start.elapsed().as_nanos() as u64);
}
      </code>
    </example>

    <example name="metrics_export">
      <description>Exporting histogram to Prometheus format</description>
      <code language="rust">
use atomic_capsule::collections::HistogramCapsule;

fn export_metrics(histogram: &amp;HistogramCapsule) -> String {
    let snapshot = histogram.percentiles();
    format!(
        "api_latency_p50_ns {}\n\
         api_latency_p95_ns {}\n\
         api_latency_p99_ns {}\n\
         api_latency_p999_ns {}\n\
         api_latency_count {}",
        snapshot.p50, snapshot.p95, snapshot.p99, snapshot.p999, snapshot.count
    )
}
      </code>
    </example>
  </examples>

