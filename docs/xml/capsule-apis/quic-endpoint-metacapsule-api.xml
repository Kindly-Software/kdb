  <!-- ========================================
       DESCRIPTION
       ======================================== -->
  <description>
    T6 Mixed tier metacapsule that orchestrates all 22 QUIC sub-capsules for complete
    QUIC/HTTP3 protocol handling. Provides &lt;10us end-to-end packet processing with
    lockfree atomic coordination.

    **Key Characteristics**:
    - Orchestrates 22 sub-capsules (T0/T1/T2/T4/T5 tiers)
    - &lt;10us packet processing end-to-end
    - 1M+ packets/sec single-threaded, 10M+ multi-threaded
    - 100% lockfree (no mutex/RwLock)
    - RFC 9000/9002/9114/9204 compliant

    **Tier Composition (T6 Mixed)**:
    - T0 Auditable: QuicAuditTrailCapsule (hash-chain compliance)
    - T1 Atomic: 10 connection/flow/congestion capsules (&lt;100ns coordination)
    - T2 SIMD: FrameParserCapsule, QpackEncoder/Decoder (5-10x acceleration)
    - T4 Batch: StreamStateTable, AckTracker, PacketBuffer (10-50x batch ops)
    - T5 Streaming: RetransmissionQueue, Http3 streams (O(1) incremental)

    **Use Cases**:
    - HTTP/3 API servers (replace Quinn/quiche)
    - CDN edge servers (10M+ packets/sec)
    - VPN tunneling (lockfree connection migration)
    - Low-latency video streaming (O(1) frame processing)
    - IoT gateways (1M+ concurrent connections)
  </description>

  <!-- ========================================
       SUB-CAPSULES (22 Total)
       ======================================== -->
  <sub-capsules>
    <group name="T1 Atomic (10 capsules)" tier="T1" purpose="Connection/Flow/Congestion Control">
      <capsule name="QuicConnectionCapsule" size="128B">Connection state machine (Idle-Established-Draining-Closed)</capsule>
      <capsule name="ConnectionIdPoolCapsule" size="256B">Connection ID management for migration (8 active CIDs)</capsule>
      <capsule name="FlowControlCapsule" size="64B">Dual-level flow control (connection + stream, Q16.16)</capsule>
      <capsule name="QuicStreamCapsule" size="64B">Per-stream state machine</capsule>
      <capsule name="StreamFlowControlCapsule" size="64B">Credit-based per-stream flow control</capsule>
      <capsule name="LossDetectionCapsule" size="128B">RTT tracking with Q16.16 (RFC 9002 section 5)</capsule>
      <capsule name="RttEstimatorCapsule" size="64B">PTO calculation (smoothed RTT, variance)</capsule>
      <capsule name="CongestionControlCapsule" size="128B">NewReno algorithm (SlowStart/CongestionAvoidance/FastRecovery)</capsule>
      <capsule name="PacingCapsule" size="64B">Token bucket rate limiting (&lt;50ns)</capsule>
      <capsule name="PacketNumberSpaceCapsule" size="64B">3 packet number spaces (Initial/Handshake/Application)</capsule>
    </group>

    <group name="T2 SIMD (3 capsules)" tier="T2" purpose="SIMD-Accelerated Parsing/Compression">
      <capsule name="FrameParserCapsule" size="256B">SIMD frame boundary detection (5-10x vs scalar)</capsule>
      <capsule name="QpackEncoderCapsule" size="1KB">Header compression (static table 61 entries, SIMD lookup)</capsule>
      <capsule name="QpackDecoderCapsule" size="1KB">Header decompression with dynamic table</capsule>
    </group>

    <group name="T4 Batch (4 capsules)" tier="T4" purpose="Batch Processing">
      <capsule name="StreamStateTableCapsule" size="32KB">Lockfree hash table for 1000+ streams</capsule>
      <capsule name="AckTrackerCapsule" size="4KB">Batch ACK range processing (10-50x vs linear)</capsule>
      <capsule name="PacketBufferCapsule" size="4KB">Ring buffer batching (512 packets)</capsule>
      <capsule name="ConnectionTableCapsule" size="8KB">Connection lookup table (1024 capacity)</capsule>
    </group>

    <group name="T5 Streaming (3 capsules)" tier="T5" purpose="O(1) Incremental Processing">
      <capsule name="RetransmissionQueueCapsule" size="2KB">O(1) FIFO retransmission queue</capsule>
      <capsule name="Http3ControlStreamCapsule" size="512B">Settings/GOAWAY processing</capsule>
      <capsule name="Http3RequestStreamCapsule" size="2KB">Chunked body processing</capsule>
    </group>

    <group name="T0 Auditable (1 capsule)" tier="T0" purpose="Compliance">
      <capsule name="QuicAuditTrailCapsule" size="256B">Hash-chain audit trail (SOX/SOC2/GDPR/HIPAA)</capsule>
    </group>
  </sub-capsules>

  <!-- ========================================
       MEMORY LAYOUT
       ======================================== -->
  <memory-layout>
    <field offset="0-7" name="state" type="AtomicU64">
      Packed state: endpoint_state(4 bits) + connection_count(20 bits) +
      stream_count(20 bits) + flags(8 bits) + generation(12 bits)
    </field>
    <field offset="8-15" name="metrics" type="AtomicU64">
      Packed metrics: bytes_sent(32 bits) + bytes_received(32 bits)
    </field>
    <field offset="16-23" name="http3_state" type="AtomicU64">
      HTTP/3 metadata: method_idx(8 bits) + path_hash(32 bits) + flags(24 bits)
    </field>
    <field offset="24-31" name="connection_table_ptr" type="AtomicPtr">
      Pointer to ConnectionTableCapsule
    </field>
    <field offset="32-39" name="stream_table_ptr" type="AtomicPtr">
      Pointer to StreamStateTableCapsule
    </field>
    <field offset="40-47" name="frame_parser_ptr" type="AtomicPtr">
      Pointer to FrameParserCapsule
    </field>
    <field offset="48-511" name="sub_capsule_ptrs" type="[AtomicPtr; ~58]">
      Pointers to remaining 19 sub-capsules + padding
    </field>
    <total-size>512 bytes</total-size>
    <alignment>64 bytes (L1 cache line)</alignment>
  </memory-layout>

  <!-- ========================================
       CONSTRUCTORS
       ======================================== -->
  <constructors>
    <constructor name="new">
      <signature>pub fn new() -> Result&lt;Self, QuicEndpointError&gt;</signature>
