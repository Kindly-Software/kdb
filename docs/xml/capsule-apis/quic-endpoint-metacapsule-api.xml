<!-- Version 1.0.0: T6 Mixed tier metacapsule orchestrating 22 QUIC sub-capsules -->
<capsule-api xmlns="http://kindly.ai/uce34/v6.0"
             name="QuicEndpointMetacapsule"
             tier="T6"
             size="512B"
             alignment="64B">

  <!-- ========================================
       METADATA
       ======================================== -->
