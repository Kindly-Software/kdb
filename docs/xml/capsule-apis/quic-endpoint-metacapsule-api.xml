  <!-- ========================================
       EXAMPLES
       ======================================== -->
  <examples>
    <example name="basic_packet_processing">
      <description>Processing incoming QUIC packets</description>
      <code language="rust">
use atomic_capsule::quic::QuicEndpointMetacapsule;

let endpoint = QuicEndpointMetacapsule::new()?;

// Process incoming UDP datagram
let packet: &amp;[u8] = receive_udp_datagram();
endpoint.on_packet_received(packet)?;

// Access HTTP/3 request data
let method = endpoint.get_http3_method();
let path = endpoint.get_http3_path();
println!("HTTP/3 {} {}", method, path);

// Monitor metrics
println!("Connections: {}", endpoint.get_connection_count());
println!("Bytes received: {}", endpoint.get_bytes_received());
      </code>
    </example>

    <example name="integration_with_universal_api">
      <description>Connecting QUIC endpoint to protocol router</description>
      <code language="rust">
use atomic_capsule::quic::QuicEndpointMetacapsule;
use atomic_capsule::meta::UniversalApiMetaCapsule;

let quic_endpoint = QuicEndpointMetacapsule::new()?;
let api_router = UniversalApiMetaCapsule::new();

// Process QUIC packet and route to appropriate handler
quic_endpoint.on_packet_received(packet)?;

// Extract HTTP/3 request for routing
let method = quic_endpoint.get_http3_method();
let path = quic_endpoint.get_http3_path();
let headers = quic_endpoint.get_http3_headers();
let body = quic_endpoint.get_http3_body();

// Route to REST/GraphQL/gRPC handler
api_router.process_http3_request(method, path, &amp;headers, &amp;body)?;
      </code>
    </example>
  </examples>

