  <!-- ========================================
       STATE TRANSITIONS
       ======================================== -->
  <state-transitions>
    <description>Endpoint state machine (mirrors QUIC connection state per RFC 9000 section 10)</description>
    <states>
      <state id="idle" value="0">No active connections, ready to accept</state>
      <state id="handshaking" value="1">TLS handshake in progress</state>
      <state id="established" value="2">Connection established, bidirectional data flow</state>
      <state id="draining" value="3">Connection draining, no new streams</state>
      <state id="closed" value="4">Connection closed, cleanup complete</state>
    </states>
    <transitions>
      <transition from="idle" to="handshaking" trigger="ClientHello received"/>
      <transition from="handshaking" to="established" trigger="Handshake complete (1-RTT)"/>
      <transition from="established" to="draining" trigger="CONNECTION_CLOSE frame"/>
      <transition from="draining" to="closed" trigger="Drain timeout (3x PTO)"/>
      <transition from="*" to="closed" trigger="Fatal error or immediate close"/>
    </transitions>
  </state-transitions>

  <!-- ========================================
       CONNECTIONS
       ======================================== -->
  <connections>
    <description>How QuicEndpointMetacapsule connects to other capsules</description>
    <input type="socket" from="UdpSocket">
      <description>Receives raw UDP datagrams containing QUIC packets</description>
      <protocol>on_packet_received() called per datagram</protocol>
    </input>
    <output type="direct" to="UniversalApiMetaCapsule">
      <description>Forwards extracted HTTP/3 requests for protocol routing</description>
      <protocol>HTTP/3 method/path/headers/body extracted for REST/GraphQL/gRPC detection</protocol>
    </output>
    <output type="event" to="QuicAuditTrailCapsule">
      <description>Records all QUIC events for compliance</description>
      <protocol>Hash-chain audit event per packet/connection/error</protocol>
    </output>
    <internal to="sub-capsules">
      <description>Orchestrates all 22 sub-capsules via atomic pointer coordination</description>
      <protocol>Direct pointer dereference with Acquire/Release ordering</protocol>
    </internal>
  </connections>

