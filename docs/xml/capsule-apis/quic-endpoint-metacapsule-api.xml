    <!-- Packet processing (core operations) -->
    <method-group category="packet-processing">
      <method name="on_packet_received">
        <signature>pub fn on_packet_received(&amp;self, packet: &amp;[u8]) -> Result&lt;(), QuicEndpointError&gt;</signature>
        <description>Processes incoming QUIC packet through full pipeline</description>
        <thread-safety>SWeMR (single writer per connection)</thread-safety>
        <latency>&lt;10us end-to-end (packet validation + frame parsing + QPACK + protocol detection)</latency>
        <memory-ordering>AcqRel (full synchronization)</memory-ordering>
        <parameters>
          <param name="packet" type="&amp;[u8]">Raw QUIC packet bytes (RFC 9000 section 12.1 format)</param>
        </parameters>
        <preconditions>
          <condition>packet.len() &gt;= 20 (minimum QUIC packet size)</condition>
          <condition>packet[0] matches QUIC magic (0xC0 or 0x40)</condition>
        </preconditions>
        <postconditions>
          <condition>Packet parsed and state updated</condition>
          <condition>bytes_received counter incremented</condition>
          <condition>HTTP/3 request extracted if present</condition>
          <condition>Audit trail event recorded</condition>
        </postconditions>
        <pipeline>
          1. Validate packet (min 20 bytes, magic byte check) - &lt;100ns
          2. Parse QUIC frames (SIMD FrameParserCapsule) - &lt;1us
          3. Update connection state (QuicConnectionCapsule) - &lt;100ns
          4. Process flow control (FlowControlCapsule) - &lt;20ns
          5. Track ACKs (AckTrackerCapsule) - &lt;50ns
          6. Extract HTTP/3 if present (QPACK decode) - &lt;1us
          7. Detect protocol (REST/GraphQL/gRPC/WebSocket/JSON-RPC/SSE) - &lt;100ns
          8. Update metrics (bytes_received, stream_count) - &lt;10ns
          9. Record audit event (QuicAuditTrailCapsule) - &lt;100ns
        </pipeline>
        <errors>
          QuicEndpointError::InvalidPacket - Packet too short or invalid magic
          QuicEndpointError::FrameParseError - QUIC frame parsing failed
          QuicEndpointError::ConnectionError - Connection state invalid
        </errors>
      </method>

      <method name="on_ack_received">
        <signature>pub fn on_ack_received(&amp;self, ack_ranges: &amp;[(u64, u64)]) -> Result&lt;(), QuicEndpointError&gt;</signature>
        <description>Processes ACK frame with batch range handling</description>
        <thread-safety>SWeMR</thread-safety>
        <latency>&lt;500ns (batch ACK processing via AckTrackerCapsule)</latency>
        <memory-ordering>AcqRel</memory-ordering>
        <parameters>
          <param name="ack_ranges" type="&amp;[(u64, u64)]">ACK ranges (start, end) pairs</param>
        </parameters>
        <postconditions>
          <condition>Acknowledged packets removed from retransmission queue</condition>
          <condition>RTT estimate updated</condition>
          <condition>Congestion window adjusted</condition>
        </postconditions>
      </method>

      <method name="on_stream_data">
        <signature>pub fn on_stream_data(&amp;self, stream_id: u64, payload: &amp;[u8]) -> Result&lt;(), QuicEndpointError&gt;</signature>
        <description>Processes STREAM frame data</description>
        <thread-safety>SWeMR</thread-safety>
        <latency>&lt;1us (stream state + flow control update)</latency>
        <memory-ordering>AcqRel</memory-ordering>
        <parameters>
          <param name="stream_id" type="u64">QUIC stream ID (RFC 9000 section 2.1)</param>
          <param name="payload" type="&amp;[u8]">Stream payload bytes</param>
        </parameters>
        <postconditions>
          <condition>Stream state updated in StreamStateTableCapsule</condition>
          <condition>Flow control credits consumed</condition>
        </postconditions>
      </method>

      <method name="on_connection_close">
        <signature>pub fn on_connection_close(&amp;self, connection_id: &amp;[u8]) -> Result&lt;(), QuicEndpointError&gt;</signature>
        <description>Handles connection close (graceful or error)</description>
        <thread-safety>SWeMR</thread-safety>
        <latency>&lt;500ns (state transition + cleanup)</latency>
        <memory-ordering>AcqRel</memory-ordering>
        <parameters>
          <param name="connection_id" type="&amp;[u8]">Connection ID to close</param>
        </parameters>
        <postconditions>
          <condition>Connection transitioned to Draining/Closed state</condition>
          <condition>Associated streams closed</condition>
          <condition>connection_count decremented</condition>
        </postconditions>
      </method>
    </method-group>

    <!-- Pointer access (for integration) -->
