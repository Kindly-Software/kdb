  <!-- ============================================================================
       MIGRATION GUIDE
       ============================================================================ -->
  <migration-guide>

    <step id="1" name="identify-hot-path">
      <description>Profile your application to find performance bottlenecks</description>
      <commands>
        <command>perf record -g ./your_app</command>
        <command>perf report</command>
      </commands>
      <criteria>Identify functions spending more than 10% time. Look for: mutex contention, cache misses, scalar loops</criteria>
    </step>

    <step id="2" name="choose-capsule-type">
      <description>Based on bottleneck characteristics</description>
      <mapping>
        <map bottleneck="Coordination overhead" capsule="Atomic Capsule"/>
        <map bottleneck="Scalar loops" capsule="SIMD Capsule"/>
        <map bottleneck="Floating-point drift" capsule="Fixed-Point Capsule"/>
      </mapping>
    </step>

    <step id="3" name="design-capsule-layout">
      <description>Pack all decision data into single structure</description>
      <before>struct OldRiskCheck { position: Mutex&lt;f64&gt;, daily_loss: Mutex&lt;f64&gt;, order_size: Mutex&lt;f64&gt;, }</before>
      <after>#[repr(C, align(128))] struct RiskLimitCapsule { packed_state: AtomicU64, // position|loss|size }</after>
    </step>

    <step id="4" name="implement-two-phase-commit">
      <description>For atomic capsules only</description>
      <writer>let odd_ver = current_ver + 1; capsule.state.store(pack_with_version(data, odd_ver), Ordering::Relaxed); let even_ver = odd_ver + 1; capsule.state.store(pack_with_version(data, even_ver), Ordering::Release);</writer>
      <reader>let snapshot = capsule.state.load(Ordering::Relaxed); if (snapshot &amp; VERSION_MASK) % 2 != 0 { return None; }</reader>
    </step>

    <step id="5" name="validate-performance">
      <description>Use B32 framework for statistical rigor</description>
      <target>95% CI, 1000+ iterations, report p50/p99/p999</target>
    </step>

  </migration-guide>

