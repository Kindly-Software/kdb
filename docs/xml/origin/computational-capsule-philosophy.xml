  <!-- ============================================================================
       UNIVERSAL CAPSULE PRINCIPLES
       ============================================================================ -->
  <universal-principles>

    <principle id="1" name="SWeMR" tier="Atomic">
      <description>Single-Writer, Many-Readers</description>
      <rules>
        <rule>One writer updates capsule state</rule>
        <rule>Many readers observe via atomic loads</rule>
        <rule>No locks required for read path</rule>
        <rule>Publication via two-phase commit (odd to even version)</rule>
      </rules>
      <pattern name="two-phase-commit">
        <writer-phase1>state.store(pack_with_odd_version(...), Ordering::Relaxed)</writer-phase1>
        <writer-phase2>state.store(pack_with_even_version(...), Ordering::Release)</writer-phase2>
        <reader>let snapshot = state.load(Ordering::Relaxed); if (snapshot &amp; VERSION_MASK) % 2 == 0 { make_decision(snapshot); }</reader>
      </pattern>
    </principle>

    <principle id="2" name="cache-alignment" tier="All">
      <description>Alignment to cache boundaries prevents false sharing</description>
      <alignments>
        <alignment size="64B">Single cache line (hot path operations, single atomic)</alignment>
        <alignment size="128B">Dual cache line (complex coordination, dual-channel atomics)</alignment>
        <alignment size="256B">Multi-line (batch operations, SIMD processing)</alignment>
      </alignments>
      <performance-impact>
        <aligned latency="9.8ns">Atomic read</aligned>
        <unaligned latency="25-50ns" penalty="3-5x slower">Due to cache line splits</unaligned>
      </performance-impact>
    </principle>

    <principle id="3" name="one-read-decisions" tier="All">
      <description>Readers make decisions from single capsule read</description>
      <rules>
        <rule>All decision data packed in one structure</rule>
        <rule>No pointer chasing (eliminates cache misses)</rule>
        <rule>Predictable latency (no variable indirection)</rule>
      </rules>
      <anti-pattern name="multiple-reads">
        <description>WRONG: Multiple atomic reads (30-50ns, torn read risk)</description>
        <code>let level = breaker.level.load(Ordering::Acquire); let cause = breaker.cause.load(Ordering::Acquire); let stale = breaker.stale.load(Ordering::Acquire);</code>
      </anti-pattern>
      <correct-pattern name="single-read">
        <description>RIGHT: One read (9.8ns, atomic snapshot)</description>
        <code>let state = breaker.state.load(Ordering::Relaxed); let level = state &amp; 0x3; let stale = (state &amp; 0x20) != 0;</code>
      </correct-pattern>
    </principle>

    <principle id="4" name="commit-flip-publishing" tier="Atomic">
      <description>Even generation = committed, Odd = in-flight</description>
      <rules>
        <rule>Writer: Increment (even to odd), update payload, increment (odd to even)</rule>
        <rule>Reader: Retry if odd generation detected</rule>
      </rules>
      <toctou-prevention>
        <writer>let odd_ver = current_ver + 1; w0.store(pack_with_version(payload, odd_ver), Ordering::Relaxed); w1.store(additional_data, Ordering::Relaxed); let even_ver = odd_ver + 1; w0.store(pack_with_version(payload, even_ver), Ordering::Release);</writer>
        <reader>let h = w0.load(Ordering::Relaxed); if (h &amp; VERSION_MASK) % 2 != 0 { return None; } let data = w1.load(Ordering::Relaxed);</reader>
      </toctou-prevention>
    </principle>

    <principle id="5" name="simd-alignment" tier="SIMD">
      <description>Register-aligned structures for vectorization</description>
      <alignments>
        <alignment bits="128" bytes="16">f32x4, i32x4</alignment>
        <alignment bits="256" bytes="32">f64x4, f32x8</alignment>
        <alignment bits="512" bytes="64">f64x8, f32x16</alignment>
      </alignments>
      <pattern>
        <code>#[repr(C, align(32))] pub struct SimdF64x4Capsule { data: [f64; 4], }</code>
        <usage>#[cfg(feature = "portable_simd")] use std::simd::f64x4; let vec = f64x4::from_array(capsule.data); let doubled = vec * f64x4::splat(2.0);</usage>
      </pattern>
    </principle>

    <principle id="6" name="fixed-point-precision" tier="Fixed-Point">
      <description>Deterministic arithmetic without floating-point drift</description>
      <formats>
        <format name="Q8.8" integer-bits="8" fractional-bits="8" precision="0.004 bp" scale="256"/>
        <format name="Q16.16" integer-bits="16" fractional-bits="16" precision="high" scale="65536"/>
      </formats>
      <pattern>
        <code>const SCALE: i64 = 256; // Q8.8; let price_fixed = (price * SCALE as f64) as i64; let vwap = (quantity * price_fixed) / total_quantity; let vwap_float = vwap as f64 / SCALE as f64;</code>
      </pattern>
    </principle>

  </universal-principles>

  <!-- ============================================================================
       ANTI-PATTERNS (Common Mistakes)
       ============================================================================ -->
  <anti-patterns>

    <anti-pattern id="1" name="multiple-separate-atomics" severity="critical">
      <description>Separate atomics for each field (cache line thrashing)</description>
      <wrong>
        <code>struct BadCircuitBreaker { level: AtomicU8, cause: AtomicU8, stale: AtomicBool, timestamp: AtomicU64, }</code>
        <consequence>4 cache lines, 30-50ns read time, torn reads possible</consequence>
      </wrong>
      <correct>
        <code>struct GoodCircuitBreaker { state: AtomicU64, _padding: [u8; 56], }</code>
        <benefit>1 cache line, 9.8ns read time, atomic snapshot guaranteed</benefit>
      </correct>
    </anti-pattern>

    <anti-pattern id="2" name="unaligned-simd-structures" severity="critical">
      <description>Natural alignment (crashes or slow)</description>
      <wrong>
        <code>struct BadSimdCapsule { data: [f64; 4], }</code>
        <consequence>Unaligned SIMD load (crashes on some platforms, 3-5x slower on others)</consequence>
      </wrong>
      <correct>
        <code>#[repr(C, align(32))] struct GoodSimdCapsule { data: [f64; 4], } verify_alignment!(GoodSimdCapsule, 32);</code>
        <benefit>Optimal SIMD performance, compile-time verified</benefit>
      </correct>
    </anti-pattern>

    <anti-pattern id="3" name="floating-point-for-financial-data" severity="critical">
      <description>Floating-point for money (rounding errors)</description>
      <wrong>
        <code>let pnl = 100.10 + 200.20 + 300.30;</code>
        <consequence>!= 600.60 due to FP rounding</consequence>
      </wrong>
      <correct>
        <code>let pnl_fixed = (10010 + 20020 + 30030);</code>
        <benefit>Q8.8: 60060 = 600.60 exactly</benefit>
      </correct>
    </anti-pattern>

    <anti-pattern id="4" name="mutex-in-hot-path" severity="critical">
      <description>Using mutex/RwLock for state coordination</description>
      <consequence>100ns+ latency, lock contention spikes</consequence>
      <solution>Use atomic capsules with SWeMR pattern</solution>
    </anti-pattern>

    <anti-pattern id="5" name="scattered-atomics" severity="high">
      <description>Multiple AtomicU64 fields in separate cache lines</description>
      <consequence>Cache thrashing, 3-5x slower reads</consequence>
      <solution>Pack all fields into single AtomicU64 with bit packing</solution>
    </anti-pattern>

    <anti-pattern id="6" name="pointer-chasing" severity="high">
      <description>Indirection through multiple pointers for decisions</description>
      <consequence>Variable latency, cache misses</consequence>
      <solution>Self-contained capsules with all decision data packed</solution>
    </anti-pattern>

  </anti-patterns>

