# MCP Debug Server Instance 4 Configuration
# Location: /etc/mcp-debug/instance-4.env
# Purpose: Environment variables for mcp-debug@4.service
# Last Modified: 2025-11-16
# Status: Production-ready

# ============================================================================
# Port Configuration
# ============================================================================
# Instance 4 uses port 5681
# Pattern: 5678 + instance_number - 1 = 5678 + 4 - 1 = 5681
MCP_PORT=5681

# ============================================================================
# State Directory Configuration
# ============================================================================
# Instance 4 state directory: /var/lib/mcp-4
# Pattern: /var/lib/mcp-{instance_number}
MCP_STATE_DIR=/var/lib/mcp-4

# ============================================================================
# Instance Identifier
# ============================================================================
# Used for logging and identification
MCP_INSTANCE=4
MCP_INSTANCE_NAME=quaternary

# ============================================================================
# Logging Configuration
# ============================================================================
# Journal identifier: mcp-debug-4
# Logs stored in: /var/log/journal/*/mcp-debug-4*
MCP_LOG_IDENTIFIER=mcp-debug-4
MCP_LOG_LEVEL=info

# ============================================================================
# Network Configuration
# ============================================================================
# Listen address: 192.168.0.38 (development server)
# For production, change to 0.0.0.0 or specific production IP
MCP_HOST=192.168.0.38
MCP_NETWORK_INTERFACE=eth0

# ============================================================================
# Resource Configuration
# ============================================================================
# Memory limits: 512MB max (enforced by systemd MemoryMax)
# CPU quota: 50% (enforced by systemd CPUQuota)
MCP_MEMORY_MAX=512M
MCP_CPU_QUOTA=50%

# ============================================================================
# Features
# ============================================================================
# Enabled features: audit-trail, ptrace-debug, rate-limiter
MCP_FEATURES=audit-trail,ptrace-debug,rate-limiter

# ============================================================================
# Performance Tuning
# ============================================================================
# Maximum concurrent clients: 256 (systemd TasksMax)
# File descriptor limit: 8192 (systemd LimitNOFILE)
MCP_MAX_CLIENTS=256
MCP_MAX_FDS=8192

# ============================================================================
# Security Configuration
# ============================================================================
# User: mcp (created during installation)
# Group: mcp
# Capabilities: CAP_SYS_PTRACE, CAP_NET_BIND_SERVICE (enforced by systemd)
MCP_USER=mcp
MCP_GROUP=mcp

# ============================================================================
# Health Check Configuration
# ============================================================================
# Health check endpoint: /health (HTTP GET)
# Health check interval: 30s
MCP_HEALTH_CHECK_INTERVAL=30
MCP_HEALTH_CHECK_TIMEOUT=5

# ============================================================================
# Debugging Configuration
# ============================================================================
# RUST_BACKTRACE: Full backtrace on panic
# RUST_LOG: Debug logging for mcp_debug, atomic_mcp_server, kdb
# RUST_LIB_BACKTRACE: Include library backtraces
RUST_BACKTRACE=1
RUST_LOG=mcp_debug=info,atomic_mcp_server=info,kdb=debug
RUST_LIB_BACKTRACE=1
