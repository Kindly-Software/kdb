{
  "title": "atomic_mcp_server SLO Tracking",
  "description": "SLO compliance, error budget, and burn rate dashboard",
  "tags": ["slo", "sla", "error-budget", "atomic-mcp-server"],
  "timezone": "utc",
  "editable": true,
  "refresh": "30s",
  "time": {
    "from": "now-30d",
    "to": "now"
  },
  "annotations": {
    "list": [
      {
        "name": "Deployments",
        "datasource": "Prometheus",
        "enable": true,
        "expr": "changes(kdb_build_info[5m]) > 0",
        "iconColor": "green",
        "tagKeys": "version",
        "textFormat": "Deployment: {{ version }}"
      },
      {
        "name": "Incidents",
        "datasource": "Prometheus",
        "enable": true,
        "expr": "ALERTS{severity=\"critical\"}",
        "iconColor": "red",
        "tagKeys": "alertname",
        "textFormat": "Incident: {{ alertname }}"
      }
    ]
  },
  "panels": [
    {
      "id": 1,
      "title": "SLO Compliance (30-day rolling window)",
      "type": "gauge",
      "datasource": "Prometheus",
      "gridPos": {"h": 8, "w": 8, "x": 0, "y": 0},
      "targets": [
        {
          "expr": "100 * (1 - (sum(rate(kdb_requests_total{status=\"error\"}[30d])) / sum(rate(kdb_requests_total[30d]))))",
          "refId": "A",
          "legendFormat": "Success Rate"
        }
      ],
      "options": {
        "showThresholdLabels": true,
        "showThresholdMarkers": true
      },
      "fieldConfig": {
        "defaults": {
          "unit": "percent",
          "min": 0,
          "max": 100,
          "thresholds": {
            "mode": "absolute",
            "steps": [
              {"value": 0, "color": "red"},
              {"value": 99.0, "color": "yellow"},
              {"value": 99.9, "color": "green"}
            ]
          }
        }
      }
    },
    {
      "id": 2,
      "title": "Error Budget (30-day)",
      "type": "gauge",
      "datasource": "Prometheus",
      "gridPos": {"h": 8, "w": 8, "x": 8, "y": 0},
      "description": "Remaining error budget. 0% = all budget consumed, 100% = no errors.",
      "targets": [
        {
          "expr": "100 * (1 - (sum(rate(kdb_requests_total{status=\"error\"}[30d])) / (0.001 * sum(rate(kdb_requests_total[30d])))))",
          "refId": "A",
          "legendFormat": "Remaining Budget"
        }
      ],
      "options": {
        "showThresholdLabels": true,
        "showThresholdMarkers": true
      },
      "fieldConfig": {
        "defaults": {
          "unit": "percent",
          "min": 0,
          "max": 100,
          "thresholds": {
            "mode": "absolute",
            "steps": [
              {"value": 0, "color": "red"},
              {"value": 25, "color": "orange"},
              {"value": 50, "color": "yellow"},
              {"value": 75, "color": "green"}
            ]
          }
        }
      }
    },
    {
      "id": 3,
      "title": "Burn Rate (1h window)",
      "type": "gauge",
      "datasource": "Prometheus",
      "gridPos": {"h": 8, "w": 8, "x": 16, "y": 0},
      "description": "How fast we're consuming error budget. >1 = burning faster than SLO allows.",
      "targets": [
        {
          "expr": "(sum(rate(kdb_requests_total{status=\"error\"}[1h])) / sum(rate(kdb_requests_total[1h]))) / 0.001",
          "refId": "A",
          "legendFormat": "Burn Rate"
        }
      ],
      "options": {
        "showThresholdLabels": true,
        "showThresholdMarkers": true
      },
      "fieldConfig": {
        "defaults": {
          "unit": "percentunit",
          "min": 0,
          "max": 10,
          "thresholds": {
            "mode": "absolute",
            "steps": [
              {"value": 0, "color": "green"},
              {"value": 1, "color": "yellow"},
              {"value": 5, "color": "orange"},
              {"value": 10, "color": "red"}
            ]
          }
        }
      }
    },
    {
      "id": 4,
      "title": "Error Budget Burndown (30-day trend)",
      "type": "timeseries",
      "datasource": "Prometheus",
      "gridPos": {"h": 8, "w": 24, "x": 0, "y": 8},
      "description": "Error budget consumption over time. Linear = on track, steep = burning too fast.",
      "targets": [
        {
          "expr": "100 * (1 - (sum(increase(kdb_requests_total{status=\"error\"}[30d])) / (0.001 * sum(increase(kdb_requests_total[30d])))))",
          "refId": "A",
          "legendFormat": "Remaining Budget"
        },
        {
          "expr": "100 * (1 - (time() - 30*24*3600) / (30*24*3600))",
          "refId": "B",
          "legendFormat": "Expected Linear Burn"
        }
      ],
      "fieldConfig": {
        "defaults": {
          "unit": "percent",
          "min": 0,
          "max": 100,
          "custom": {
            "lineWidth": 2,
            "fillOpacity": 10
          }
        }
      }
    },
    {
      "id": 5,
      "title": "P50/P95/P99 Latency (5m rolling)",
      "type": "timeseries",
      "datasource": "Prometheus",
      "gridPos": {"h": 8, "w": 12, "x": 0, "y": 16},
      "targets": [
        {
          "expr": "histogram_quantile(0.50, rate(kdb_request_duration_seconds_bucket[5m]))",
          "refId": "A",
          "legendFormat": "P50"
        },
        {
          "expr": "histogram_quantile(0.95, rate(kdb_request_duration_seconds_bucket[5m]))",
          "refId": "B",
          "legendFormat": "P95"
        },
        {
          "expr": "histogram_quantile(0.99, rate(kdb_request_duration_seconds_bucket[5m]))",
          "refId": "C",
          "legendFormat": "P99"
        }
      ],
      "fieldConfig": {
        "defaults": {
          "unit": "s",
          "custom": {
            "lineWidth": 2,
            "fillOpacity": 10
          }
        }
      }
    },
    {
      "id": 6,
      "title": "Request Rate & Error Rate (5m rolling)",
      "type": "timeseries",
      "datasource": "Prometheus",
      "gridPos": {"h": 8, "w": 12, "x": 12, "y": 16},
      "targets": [
        {
          "expr": "sum(rate(kdb_requests_total[5m]))",
          "refId": "A",
          "legendFormat": "Total RPS"
        },
        {
          "expr": "sum(rate(kdb_requests_total{status=\"success\"}[5m]))",
          "refId": "B",
          "legendFormat": "Success RPS"
        },
        {
          "expr": "sum(rate(kdb_requests_total{status=\"error\"}[5m]))",
          "refId": "C",
          "legendFormat": "Error RPS"
        }
      ],
      "fieldConfig": {
        "defaults": {
          "unit": "reqps",
          "custom": {
            "lineWidth": 2,
            "fillOpacity": 10,
            "stacking": {"mode": "none"}
          }
        }
      }
    },
    {
      "id": 7,
      "title": "SLA Violation History (24h)",
      "type": "table",
      "datasource": "Prometheus",
      "gridPos": {"h": 8, "w": 12, "x": 0, "y": 24},
      "description": "Count of SLA violations in last 24h by alert type",
      "targets": [
        {
          "expr": "count_over_time(ALERTS{category=\"sla\", severity=\"critical\"}[24h])",
          "refId": "A",
          "format": "table",
          "instant": true
        }
      ],
      "transformations": [
        {
          "id": "organize",
          "options": {
            "excludeByName": {},
            "indexByName": {"alertname": 0, "Value": 1},
            "renameByName": {"alertname": "SLA Violation", "Value": "Count (24h)"}
          }
        }
      ]
    },
    {
      "id": 8,
      "title": "Error Budget Time Remaining",
      "type": "stat",
      "datasource": "Prometheus",
      "gridPos": {"h": 8, "w": 12, "x": 12, "y": 24},
      "description": "Estimated days until error budget exhausted at current burn rate",
      "targets": [
        {
          "expr": "30 * (1 - (sum(rate(kdb_requests_total{status=\"error\"}[30d])) / (0.001 * sum(rate(kdb_requests_total[30d]))))) / ((sum(rate(kdb_requests_total{status=\"error\"}[1h])) / sum(rate(kdb_requests_total[1h]))) / 0.001)",
          "refId": "A",
          "legendFormat": "Days Remaining"
        }
      ],
      "fieldConfig": {
        "defaults": {
          "unit": "days",
          "thresholds": {
            "mode": "absolute",
            "steps": [
              {"value": 0, "color": "red"},
              {"value": 7, "color": "orange"},
              {"value": 14, "color": "yellow"},
              {"value": 21, "color": "green"}
            ]
          }
        }
      },
      "options": {
        "textMode": "value_and_name",
        "colorMode": "background"
      }
    },
    {
      "id": 9,
      "title": "Top 5 Tools by Error Rate",
      "type": "table",
      "datasource": "Prometheus",
      "gridPos": {"h": 8, "w": 12, "x": 0, "y": 32},
      "targets": [
        {
          "expr": "topk(5, sum(rate(kdb_requests_total{status=\"error\"}[5m])) by (tool))",
          "refId": "A",
          "format": "table",
          "instant": true
        }
      ],
      "transformations": [
        {
          "id": "organize",
          "options": {
            "renameByName": {"tool": "Tool", "Value": "Error Rate (RPS)"}
          }
        }
      ]
    },
    {
      "id": 10,
      "title": "Tool-Level SLO Compliance",
      "type": "heatmap",
      "datasource": "Prometheus",
      "gridPos": {"h": 8, "w": 12, "x": 12, "y": 32},
      "description": "Success rate per tool (green = 100%, red = <99%)",
      "targets": [
        {
          "expr": "100 * (sum(rate(kdb_requests_total{status=\"success\"}[5m])) by (tool) / sum(rate(kdb_requests_total[5m])) by (tool))",
          "refId": "A",
          "format": "time_series"
        }
      ],
      "options": {
        "calculate": false,
        "cellGap": 2,
        "color": {
          "mode": "scheme",
          "scheme": "RdYlGn",
          "steps": 128
        },
        "yAxis": {
          "decimals": 0
        }
      }
    }
  ],
  "templating": {
    "list": [
      {
        "name": "slo_target",
        "type": "constant",
        "current": {"value": "99.0", "text": "99.0%"},
        "description": "SLO target (99% success rate)"
      },
      {
        "name": "time_window",
        "type": "interval",
        "current": {"value": "30d", "text": "30 days"},
        "options": [
          {"value": "7d", "text": "7 days"},
          {"value": "30d", "text": "30 days"},
          {"value": "90d", "text": "90 days"}
        ]
      }
    ]
  },
  "version": 1
}
