# KDB Signup Service Environment Configuration
# Copy this file to /etc/kdb/kdb-signup.env and fill in actual values

# Resend API Key (required)
# Get from: https://resend.com/api-keys
RESEND_API_KEY=re_xxxxxxxxxxxx

# Ed25519 Signing Key Path (required)
# Generate with: kdb keygen --output /etc/kdb/private_key.hex
SIGNING_KEY_PATH=/etc/kdb/private_key.hex

# KindlyDB API URL (required)
# Default: http://localhost:8080
KINDLYDB_URL=http://localhost:8080

# Email Verification Service URL (required)
# Production: https://api.kindly.software/v1/verify
VERIFICATION_URL=https://api.kindly.software/v1/verify

# From Email Address (required)
# Must be verified in Resend account
FROM_EMAIL=noreply@kindly.software

# Promotion End Timestamp (required)
# Unix timestamp for 7-day early adopter promo
# Calculate: date -d "+7 days" +%s
# Current value expires: 2025-12-14 (7 days from deployment date)
PROMO_END_TIMESTAMP=1765734726

# Logging Level (optional)
# Options: error, warn, info, debug, trace
# Default: info
RUST_LOG=info

# Server Configuration (optional, defaults shown)
# PORT=8091
# HOST=0.0.0.0

# Email Template Configuration (optional)
# COMPANY_NAME=Kindly Technologies
# SUPPORT_EMAIL=support@kindly.software
