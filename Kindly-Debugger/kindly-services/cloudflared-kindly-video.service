[Unit]
Description=Cloudflare Tunnel for kindly.video
After=network.target kindly-video.service
Wants=kindly-video.service

[Service]
Type=simple
User=samuel
ExecStart=/usr/local/bin/cloudflared tunnel --config /home/samuel/Primitives/kindly-video/cloudflared-config.yml run
Restart=always
RestartSec=5

# Security hardening
NoNewPrivileges=yes
ProtectSystem=strict
PrivateTmp=yes

[Install]
WantedBy=multi-user.target
