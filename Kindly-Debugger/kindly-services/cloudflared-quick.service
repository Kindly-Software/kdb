[Unit]
Description=Cloudflare Quick Tunnel for kindly-video
After=network.target kindly-video.service
Requires=kindly-video.service

[Service]
Type=simple
User=samuel
ExecStart=/usr/local/bin/cloudflared tunnel --url http://localhost:8081
Restart=always
RestartSec=5

# Security hardening
NoNewPrivileges=yes
ProtectSystem=strict
PrivateTmp=yes

[Install]
WantedBy=multi-user.target
