<!-- ============================================================================
     TROUBLESHOOTING
     ============================================================================ -->
<troubleshooting>
  <issue id="1">
    <symptom>Hooks not executing (commits succeed without checks)</symptom>
    <cause>Hook not executable or wrong location</cause>
    <fix>
      <step>Verify hooks exist: <code>ls -la .git/hooks/</code></step>
      <step>Make executable: <code>chmod +x .git/hooks/pre-commit</code></step>
      <step>Test manually: <code>.git/hooks/pre-commit</code></step>
    </fix>
  </issue>

  <issue id="2">
    <symptom>"cargo: command not found" in hooks</symptom>
    <cause>Git hooks don't inherit shell environment</cause>
    <fix>Already included in hooks via <code>export PATH="$HOME/.cargo/bin:$PATH"</code></fix>
  </issue>

  <issue id="3">
    <symptom>Slow hook execution (&gt;30s)</symptom>
    <cause>Missing incremental compilation or LLD linker</cause>
    <fix>
      <step>Enable incremental: Add to Cargo.toml <code>[profile.dev] incremental = true</code></step>
      <step>Install LLD: <code>sudo apt install lld</code> (Ubuntu) or <code>brew install llvm</code> (macOS)</step>
      <step>Verify config: <code>grep "lld" .cargo/config.toml</code></step>
    </fix>
  </issue>

  <issue id="4">
    <symptom>"unknown lint: clippy::capsule_mutex_violation"</symptom>
    <cause>clippy-capsule-verify plugin not loaded</cause>
    <fix>
      <step>Use nightly Rust: <code>rustup override set nightly</code></step>
      <step>Rebuild plugin: <code>cd /path/to/clippy-capsule-verify &amp;&amp; cargo build --release</code></step>
      <step>Verify plugin: <code>ls -lh target/release/libclipper_capsule_verify.so</code></step>
    </fix>
  </issue>

  <issue id="5">
    <symptom>GitHub Actions cache errors</symptom>
    <cause>Cache key mismatch or corruption</cause>
    <fix>Add restore-keys for fallback in workflow YAML</fix>
  </issue>
</troubleshooting>

