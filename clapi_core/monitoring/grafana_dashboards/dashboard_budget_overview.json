{
  "dashboard": {
    "title": "clapi_core - Budget Overview",
    "tags": ["clapi_core", "budget", "slo"],
    "timezone": "browser",
    "schemaVersion": 16,
    "version": 1,
    "refresh": "10s",
    "panels": [
      {
        "id": 1,
        "title": "Active Budgets",
        "type": "stat",
        "gridPos": {"h": 8, "w": 6, "x": 0, "y": 0},
        "targets": [
          {
            "expr": "clapi_budget_active_count",
            "legendFormat": "Active Budgets"
          }
        ],
        "options": {
          "graphMode": "area",
          "colorMode": "value"
        },
        "fieldConfig": {
          "defaults": {
            "unit": "short",
            "thresholds": {
              "mode": "absolute",
              "steps": [
                {"value": null, "color": "green"},
                {"value": 800000, "color": "yellow"},
                {"value": 900000, "color": "red"}
              ]
            }
          }
        }
      },
      {
        "id": 2,
        "title": "Budget Deductions/sec",
        "type": "graph",
        "gridPos": {"h": 8, "w": 9, "x": 6, "y": 0},
        "targets": [
          {
            "expr": "rate(clapi_budget_deductions_total[1m])",
            "legendFormat": "Deductions/sec"
          }
        ],
        "yaxes": [
          {"format": "ops", "label": "Operations/sec"},
          {"format": "short", "show": false}
        ]
      },
      {
        "id": 3,
        "title": "Budget Exhaustion Rate",
        "type": "gauge",
        "gridPos": {"h": 8, "w": 9, "x": 15, "y": 0},
        "targets": [
          {
            "expr": "(clapi_budget_exhausted_count / clapi_budget_active_count) * 100",
            "legendFormat": "Exhaustion %"
          }
        ],
        "fieldConfig": {
          "defaults": {
            "unit": "percent",
            "min": 0,
            "max": 100,
            "thresholds": {
              "mode": "absolute",
              "steps": [
                {"value": 0, "color": "green"},
                {"value": 25, "color": "yellow"},
                {"value": 50, "color": "red"}
              ]
            }
          }
        }
      },
      {
        "id": 4,
        "title": "Budget Allocation Latency (P50, P95, P99)",
        "type": "graph",
        "gridPos": {"h": 8, "w": 12, "x": 0, "y": 8},
        "targets": [
          {
            "expr": "histogram_quantile(0.50, rate(clapi_budget_allocation_latency_ns_bucket[1m]))",
            "legendFormat": "P50"
          },
          {
            "expr": "histogram_quantile(0.95, rate(clapi_budget_allocation_latency_ns_bucket[1m]))",
            "legendFormat": "P95"
          },
          {
            "expr": "histogram_quantile(0.99, rate(clapi_budget_allocation_latency_ns_bucket[1m]))",
            "legendFormat": "P99"
          }
        ],
        "yaxes": [
          {"format": "ns", "label": "Latency (ns)"},
          {"format": "short", "show": false}
        ],
        "alert": {
          "conditions": [
            {
              "evaluator": {"params": [100], "type": "gt"},
              "operator": {"type": "and"},
              "query": {"params": ["A", "1m", "now"]},
              "reducer": {"params": [], "type": "avg"},
              "type": "query"
            }
          ],
          "executionErrorState": "alerting",
          "frequency": "1m",
          "handler": 1,
          "name": "Budget Allocation Latency P99 > 100ns",
          "noDataState": "no_data",
          "notifications": []
        }
      },
      {
        "id": 5,
        "title": "CAS Retry Rate",
        "type": "graph",
        "gridPos": {"h": 8, "w": 12, "x": 12, "y": 8},
        "targets": [
          {
            "expr": "(rate(clapi_budget_cas_retries_total[1m]) / rate(clapi_budget_deductions_total[1m])) * 100",
            "legendFormat": "Retry %"
          }
        ],
        "yaxes": [
          {"format": "percent", "label": "Retry Rate"},
          {"format": "short", "show": false}
        ],
        "alert": {
          "conditions": [
            {
              "evaluator": {"params": [10], "type": "gt"},
              "operator": {"type": "and"},
              "query": {"params": ["A", "5m", "now"]},
              "reducer": {"params": [], "type": "avg"},
              "type": "query"
            }
          ],
          "executionErrorState": "alerting",
          "frequency": "1m",
          "handler": 1,
          "name": "CAS Retry Rate > 10%",
          "noDataState": "no_data",
          "notifications": []
        }
      },
      {
        "id": 6,
        "title": "Budget Slot Utilization",
        "type": "graph",
        "gridPos": {"h": 8, "w": 24, "x": 0, "y": 16},
        "targets": [
          {
            "expr": "(clapi_budget_active_count / 1000000) * 100",
            "legendFormat": "Utilization %"
          }
        ],
        "yaxes": [
          {"format": "percent", "label": "Slot Utilization", "max": 100},
          {"format": "short", "show": false}
        ]
      }
    ]
  }
}
