        let amount_cents = 10_00;
        let stripe_intent_id = format!("pi_{}", i);

        let payment = PaymentCapsule256::new_pending(
            user_id,
            BUDGET_ANTHROPIC,
            amount_cents,
            &stripe_intent_id,
