// Full Stack End-to-End Load Tests - T28 Q18 Production Load Validation
//
// Validates complete system performance under realistic production workload:
// - 10K users × 100 req/sec = 1M requests total
// - Budget validation + OAuth verification + Payment tracking + Circuit breaker
// - End-to-end latency (request in → response out)
//
// Performance Budget (from CLAUDE.md):
// - Budget validation: <60ns
// - OAuth verification: <30ns
// - Payment tracking: <60ns
// - Provider routing: <80ns
// - Overhead: <70ns
// - Total hot path: <300ns (0.3% of 100ms provider latency)
// - Target: P50 <10ms, P99 <100ms

use clapi_core::BudgetMetacapsule;
use clapi_core::capsules::CircuitBreaker;
use clapi_core::auth::OAuthSessionCapsule;
use clapi_core::capsules::PaymentCapsule256;
use clapi_core::capsules::ProviderCircuitArray;
use clapi_core::client::{BUDGET_ANTHROPIC, BUDGET_OPENAI, BUDGET_GOOGLE};
use std::sync::Arc;
use std::time::{Duration, Instant};

#[path = "../load_test_common.rs"]
mod load_test_common;
use load_test_common::{LoadTestConfig, LoadTestHarness};

/// Full system integration representing complete production stack:
/// - Budget registry (1M budgets)
/// - OAuth sessions (100K sessions)
/// - Payment tracking (50K payments)
/// - Circuit breakers (16 providers)
struct ProductionSystem {
    budget_registry: Arc<BudgetMetacapsule>,
    oauth_sessions: Arc<dashmap::DashMap<u64, OAuthSessionCapsule>>,
    payments: Arc<dashmap::DashMap<u64, PaymentCapsule256>>,
    provider_circuits: Arc<ProviderCircuitArray>,
    global_circuit: Arc<CircuitBreaker>,
}

impl ProductionSystem {
    fn new() -> Self {
        Self {
            budget_registry: Arc::new(BudgetMetacapsule::new()),
            oauth_sessions: Arc::new(dashmap::DashMap::new()),
            payments: Arc::new(dashmap::DashMap::new()),
            provider_circuits: Arc::new(ProviderCircuitArray::new()),
            global_circuit: Arc::new(CircuitBreaker::new()),
        }
    }

    fn pre_populate(&self, num_budgets: usize, num_sessions: usize, num_payments: usize) {
        println!("Pre-populating system...");

        // Budgets
        print!("  Budgets: {} ... ", num_budgets);
        for i in 0..num_budgets {
            let budget_id = i as u64;
            let _ = self.budget_registry.get_or_create_budget(budget_id, 1_000_00);
        }
        println!("✓");

        // OAuth sessions
        print!("  OAuth sessions: {} ... ", num_sessions);
        for i in 0..num_sessions {
            let session_id = i as u64;
            let user_id = i as u64;
            let session = OAuthSessionCapsule::new_active(
                user_id,
                &format!("token_{}", i),
                &format!("refresh_{}", i),
                3600,
            );
            self.oauth_sessions.insert(session_id, session);
        }
        println!("✓");

        // Payments
        print!("  Payments: {} ... ", num_payments);
        for i in 0..num_payments {
            let payment_id = i as u64;
            let user_id = i as u64;
            let payment = PaymentCapsule256::new_pending(
                user_id,
                BUDGET_ANTHROPIC,
                10_00,
                &format!("pi_{}", i),
            );
            self.payments.insert(payment_id, payment);
        }
        println!("✓");

        // Provider circuits
        print!("  Provider circuits: 16 ... ");
        for provider_id in 0..16 {
            let status = self.provider_circuits.get_provider_status(provider_id);
            for _ in 0..100 {
                status.record_success();
            }
        }
        println!("✓");

        println!("Pre-population complete\n");
    }

    /// Simulate a complete production request
    fn handle_request(&self, user_id: u64, budget_id: u64, amount_cents: i64) -> Result<(), &'static str> {
        // 1. OAuth verification (<30ns target)
        if let Some(session) = self.oauth_sessions.get(&user_id) {
            if !session.is_active() {
                return Err("Session expired");
            }
        } else {
            return Err("No session");
        }

        // 2. Budget validation (<60ns target)
        if let Some(budget) = self.budget_registry.get_budget(budget_id) {
            if budget.try_deduct(amount_cents).is_err() {
                return Err("Insufficient budget");
            }
        } else {
            return Err("Budget not found");
        }

        // 3. Circuit breaker check (<5ns target)
        if self.global_circuit.check().is_err() {
            return Err("Circuit open");
        }

        // 4. Provider routing (<80ns target)
        let provider_id = (user_id % 16) as usize;
        let status = self.provider_circuits.get_provider_status(provider_id);
        if status.check().is_err() {
            return Err("Provider circuit open");
        }

        // 5. Record success metrics
        self.global_circuit.record_success();
        status.record_success();

        Ok(())
    }
}

/// Scenario 1: Baseline end-to-end performance
///
/// Target: <10ms p50, <100ms p99
/// Load: 10K requests/sec across all components
#[test]
#[ignore] // Run with: cargo test --test full_stack_load_test -- --ignored
#[ignore] // FIXME: Update for new capsule APIs
fn scenario1_baseline_e2e_performance() {
    println!("\n=== Scenario 1: Baseline End-to-End Performance ===\n");

    let system = Arc::new(ProductionSystem::new());
    system.pre_populate(100_000, 50_000, 20_000);

    let thread_counts = vec![8, 16, 32];

    for threads in thread_counts {
        println!("\n--- Testing with {} threads ---", threads);

        let config = LoadTestConfig {
            duration_secs: 60,
            threads,
            requests_per_sec: 10_000,
            warmup_duration: Duration::from_secs(10),
            cooldown_duration: Duration::from_secs(5),
        };

        let system_handle = Arc::clone(&system);
        let harness = LoadTestHarness::new(config);

        let results = harness.run(move || {
            let user_id = rand::random::<u64>() % 50_000;
            let budget_id = rand::random::<u64>() % 100_000;
            let amount_cents = 10; // $0.10

            let _ = system_handle.handle_request(user_id, budget_id, amount_cents);
        });

        println!("{}", results.summary());

        // Assertions: <10ms p50 target
        assert!(
            results.meets_p50_target(),
            "E2E P50 {:.2}ms exceeds 10ms target ({}T)",
            results.latency_p50_ms,
            threads
        );

        // Assertions: <100ms p99 target
        assert!(
            results.latency_p99_ms < 100.0,
            "E2E P99 {:.2}ms exceeds 100ms threshold ({}T)",
            results.latency_p99_ms,
            threads
        );
    }
}

/// Scenario 2: Heavy load (100K requests/sec)
///
/// Target: System maintains <10ms p50 under heavy load
/// Load: 100K requests/sec, 32 threads
#[test]
#[ignore]
#[ignore] // FIXME: Update for new capsule APIs
fn scenario2_heavy_load_100k_rps() {
    println!("\n=== Scenario 2: Heavy Load (100K req/s) ===\n");

    let system = Arc::new(ProductionSystem::new());
    system.pre_populate(100_000, 50_000, 20_000);

    let config = LoadTestConfig {
        duration_secs: 60,
        threads: 32,
        requests_per_sec: 100_000,
        warmup_duration: Duration::from_secs(10),
        cooldown_duration: Duration::from_secs(5),
    };

    let system_handle = Arc::clone(&system);
    let harness = LoadTestHarness::new(config);

    let results = harness.run(move || {
        let user_id = rand::random::<u64>() % 50_000;
        let budget_id = rand::random::<u64>() % 100_000;
        let amount_cents = 10;

        let _ = system_handle.handle_request(user_id, budget_id, amount_cents);
    });

    println!("{}", results.summary());

    // Assertions: <10ms p50 target (even under heavy load)
    assert!(
        results.meets_p50_target(),
        "Heavy load P50 {:.2}ms exceeds 10ms target",
        results.latency_p50_ms
    );

    // Assertions: Throughput should be very high
    assert!(
        results.throughput_rps > 50_000.0,
        "Throughput {:.0} req/s too low",
        results.throughput_rps
    );
}

/// Scenario 3: Realistic production workload (1M total requests)
///
/// Target: <10ms p50 sustained over 1M requests
/// Load: 10K users × 100 req/sec, distributed across all components
#[test]
#[ignore]
#[ignore] // FIXME: Update for new capsule APIs
fn scenario3_realistic_production_1m_requests() {
    println!("\n=== Scenario 3: Realistic Production (1M requests) ===\n");

    let system = Arc::new(ProductionSystem::new());
    system.pre_populate(10_000, 10_000, 5_000);

    let config = LoadTestConfig {
        duration_secs: 100, // ~1M requests at 10K/sec
        threads: 16,
        requests_per_sec: 10_000,
        warmup_duration: Duration::from_secs(10),
        cooldown_duration: Duration::from_secs(5),
    };

    let system_handle = Arc::clone(&system);
    let harness = LoadTestHarness::new(config);

    let results = harness.run(move || {
        // Realistic user behavior: 80% known users, 20% new
        let is_known_user = rand::random::<u8>() % 100 < 80;
        let user_id = if is_known_user {
            rand::random::<u64>() % 10_000
        } else {
            rand::random::<u64>()
        };

        let budget_id = rand::random::<u64>() % 10_000;
        let amount_cents = 10;

        let _ = system_handle.handle_request(user_id, budget_id, amount_cents);
    });

    println!("{}", results.summary());

    // Assertions: <10ms p50 target sustained over 1M requests
    assert!(
        results.meets_p50_target(),
        "Production P50 {:.2}ms exceeds 10ms target (1M requests)",
        results.latency_p50_ms
    );

    // Assertions: Total requests should be ~1M
    assert!(
        results.total_requests > 900_000,
        "Total requests {} below 1M target",
        results.total_requests
    );

    // Assertions: High success rate (>99%)
    let success_rate = results.success_count as f64 / results.total_requests as f64;
    assert!(
        success_rate > 0.99,
        "Success rate {:.2}% too low",
        success_rate * 100.0
    );
}

/// Scenario 4: Mixed failure modes
///
/// Target: System gracefully degrades with partial failures
/// Load: 10K req/sec with 5% budget exhaustion, 2% circuit open
#[test]
#[ignore]
#[ignore] // FIXME: Update for new capsule APIs
fn scenario4_mixed_failure_modes() {
    println!("\n=== Scenario 4: Mixed Failure Modes ===\n");

    let system = Arc::new(ProductionSystem::new());
    system.pre_populate(10_000, 10_000, 5_000);

    let config = LoadTestConfig {
        duration_secs: 60,
        threads: 16,
        requests_per_sec: 10_000,
        warmup_duration: Duration::from_secs(10),
        cooldown_duration: Duration::from_secs(5),
    };

    let system_handle = Arc::clone(&system);
    let harness = LoadTestHarness::new(config);

    let results = harness.run(move || {
        let user_id = rand::random::<u64>() % 10_000;
        let budget_id = rand::random::<u64>() % 10_000;

        // Simulate varying load: some requests use more budget
        let amount_cents = if rand::random::<u8>() % 100 < 10 {
            1000 // 10% of requests are expensive ($10)
        } else {
            10 // 90% are cheap ($0.10)
        };

        // Simulate provider failures (2% failure rate)
        if rand::random::<u8>() % 100 < 2 {
            let provider_id = rand::random::<usize>() % 16;
            let status = system_handle.provider_circuits.get_provider_status(provider_id);
            status.record_failure();
        }

        let _ = system_handle.handle_request(user_id, budget_id, amount_cents);
    });

    println!("{}", results.summary());

    // Assertions: <10ms p50 target (even with failures)
    assert!(
        results.meets_p50_target(),
        "Mixed failures P50 {:.2}ms exceeds 10ms target",
        results.latency_p50_ms
    );

    // Assertions: P99 should stay reasonable (<100ms)
    assert!(
        results.latency_p99_ms < 100.0,
        "Mixed failures P99 {:.2}ms too high",
        results.latency_p99_ms
    );
}
