#[allow(dead_code)]
fn request(id: &str) -> String {
    id.to_string()
}

#[allow(dead_code)]
fn hash(s: &str) -> u64 {
    use std::collections::hash_map::DefaultHasher;
    use std::hash::{Hash, Hasher};
    let mut hasher = DefaultHasher::new();
    s.hash(&mut hasher);
    hasher.finish()
}

