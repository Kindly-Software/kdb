#[cfg(feature = "week4-cost-forecast")]
mod cost_forecasting_property_tests {
    use super::*;

    proptest! {
        /// Property: Linear trend → bounded error
        ///
        /// Invariant: |predicted - actual| ≤ 2 × noise_stddev
        #[test]
        fn prop_forecast_error_bounded(
            trend_slope in -100.0f64..100.0,
            noise_stddev in 0.0f64..10.0
        ) {
            use rand::{Rng, SeedableRng};
            use rand::rngs::StdRng;

            let forecaster = CostForecaster::new();
            let mut rng = StdRng::seed_from_u64(42);

            // Generate linear trend + noise
            for i in 0..1000 {
                let base = 1000.0 + trend_slope * i as f64;
                let noise = rng.gen_range(-noise_stddev..noise_stddev);
                let cost = (base + noise).max(0.0) as i64;
                forecaster.record_cost(i * 60_000_000_000, cost);
            }

            // Predict next value
            let predicted = forecaster.predict_at_offset(1) as f64;
            let actual = 1000.0 + trend_slope * 1000.0;
            let error = (predicted - actual).abs();

            // Error should be ≤ 2× noise stddev + slope magnitude
            prop_assert!(error <= 2.0 * noise_stddev + trend_slope.abs(),
                        "Error: {:.2}, expected ≤ {:.2}",
                        error, 2.0 * noise_stddev + trend_slope.abs());
        }

        /// Property: Trend calculation stable
        ///
        /// Invariant: Repeated calculations → same result
        #[test]
        fn prop_trend_calculation_stable(
            num_samples in 100usize..1000
        ) {
            let forecaster = CostForecaster::new();

            // Linear trend: y = x
            for i in 0..num_samples {
                forecaster.record_cost(i as u64 * 60_000_000_000, i as i64);
            }

            // Multiple predictions should be stable
            let pred1 = forecaster.predict_next_hour();
            let pred2 = forecaster.predict_next_hour();
            let pred3 = forecaster.predict_next_hour();

            prop_assert_eq!(pred1, pred2);
            prop_assert_eq!(pred2, pred3);
        }

        /// Property: Anomaly detection sensitivity
        ///
        /// Invariant: spike > 3σ → anomaly detected
        #[test]
        fn prop_anomaly_detection_sensitivity(
            base_cost in 100i64..1000,
            spike_multiplier in 3u64..10
        ) {
            let forecaster = CostForecaster::new();

            // Normal costs
            for i in 0..100 {
                forecaster.record_cost(i * 60_000_000_000, base_cost);
            }

            // Spike
            let spike = base_cost * spike_multiplier as i64;

            // Should detect anomaly
            prop_assert!(forecaster.detect_anomaly(spike),
                        "Failed to detect {:.1}× spike", spike_multiplier);
        }

        /// Property: Concurrent updates commutative
        ///
        /// Invariant: Order of updates doesn't affect final trend
        #[test]
        fn prop_concurrent_updates_commutative(
            num_threads in 2usize..10,
            samples_per_thread in 100usize..1000
        ) {
            use std::thread;

            let forecaster = Arc::new(CostForecaster::new());

            let handles: Vec<_> = (0..num_threads).map(|thread_id| {
                let fc = forecaster.clone();
                thread::spawn(move || {
                    for j in 0..samples_per_thread {
                        let timestamp = (thread_id * samples_per_thread + j) as u64 * 60_000_000_000;
                        fc.record_cost(timestamp, (thread_id + j) as i64);
                    }
                })
            }).collect();

            for h in handles {
                h.join().unwrap();
            }

            // Trend should be stable (order doesn't matter)
            let predicted = forecaster.predict_next_hour();
            prop_assert!(predicted > 0);
            prop_assert!(predicted < 1_000_000);  // Reasonable bounds
        }
    }
}

