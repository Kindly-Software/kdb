// ADVANCED RATE LIMITING PROPERTY TESTS (1000+ cases)
// ============================================================================

#[cfg(feature = "week4-rate-limiting")]
mod rate_limiting_property_tests {
    use super::*;

    proptest! {
        /// Property: Jitter always positive and bounded
        ///
        /// Invariant: jitter ∈ [0, refill_rate/10)
        #[test]
        fn prop_jitter_always_positive_and_bounded(
            capacity in 1u64..10000,
            refill_ns in 1u64..1_000_000_000
        ) {
            let limiter = AdvancedRateLimiter::new(capacity, Duration::from_nanos(refill_ns));

            for _ in 0..100 {
                match limiter.acquire_with_jitter(1) {
                    Ok(jitter) => {
                        prop_assert!(jitter.as_nanos() >= 0);
                        prop_assert!(jitter.as_nanos() < (refill_ns / 10) as u128);
                    }
                    Err(_) => {}  // Rate limited (acceptable)
                }
            }
        }

        /// Property: No integer overflow
        ///
        /// Invariant: acquire(N) never panics for any N
        #[test]
        fn prop_no_overflow(
            capacity in 1u64..u64::MAX,
            tokens in 0u64..1000
        ) {
            let limiter = AdvancedRateLimiter::new(capacity, Duration::from_nanos(1));

            // Should not panic on extreme values
            for _ in 0..100 {
                let _ = limiter.acquire_with_jitter(tokens);
            }
        }

        /// Property: Fairness (eventually consistent)
        ///
        /// Invariant: After N refills, all users get ≈equal tokens
        #[test]
        fn prop_fairness_eventually_consistent(
            num_users in 2usize..100,
            capacity in 100u64..1000
        ) {
            let limiter = Arc::new(AdvancedRateLimiter::new(capacity, Duration::from_millis(10)));
            let user_tokens = Arc::new(tokio::sync::Mutex::new(vec![0u64; num_users]));

            let runtime = tokio::runtime::Runtime::new().unwrap();
            runtime.block_on(async {
                let handles: Vec<_> = (0..num_users).map(|user_id| {
                    let lim = limiter.clone();
                    let tokens = user_tokens.clone();
                    tokio::spawn(async move {
                        for _ in 0..100 {
                            if lim.acquire_with_jitter(user_id as u64).is_ok() {
                                tokens.lock().await[user_id] += 1;
                            }
                            tokio::time::sleep(Duration::from_millis(1)).await;
                        }
                    })
                }).collect();

                for h in handles {
                    h.await.unwrap();
                }

                // Verify fairness: all users got some tokens
                let tokens = user_tokens.lock().await;
                let min = tokens.iter().min().unwrap();
                let max = tokens.iter().max().unwrap();

                // Variance should be ≤2× (not perfectly fair, but reasonable)
                prop_assert!(*max <= 2 * *min,
                            "Fairness violated: min={}, max={}", min, max);

                Ok(())
            })?;
        }

        /// Property: Backpressure monotonic
        ///
        /// Invariant: Higher load → higher backpressure level
        #[test]
        fn prop_backpressure_monotonic(
            base_rate in 10u64..1000,
            load_multiplier in 2u64..10
        ) {
            let limiter = AdvancedRateLimiter::new(base_rate, Duration::from_secs(1));

            // Low load
            for _ in 0..base_rate / 2 {
                let _ = limiter.acquire_with_jitter(1);
            }
            let low_backpressure = limiter.current_backpressure_level();

            // High load
            for _ in 0..base_rate * load_multiplier {
                let _ = limiter.acquire_with_jitter(1);
            }
            let high_backpressure = limiter.current_backpressure_level();

            // Higher load should NOT reduce backpressure
            prop_assert!(high_backpressure >= low_backpressure,
                        "Backpressure decreased under load: low={}, high={}",
                        low_backpressure, high_backpressure);
        }
    }
}

