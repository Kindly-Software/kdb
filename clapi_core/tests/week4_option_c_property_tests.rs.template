#[cfg(feature = "week4-coalescing")]
mod coalescing_property_tests {
    use super::*;

    proptest! {
        /// Property: All coalesced requests receive the same result
        ///
        /// Invariant: ∀ requests with same hash → same result
        #[test]
        fn prop_coalescing_preserves_result(
            request_patterns in prop::collection::vec((0u64..100, 0u64..10), 100..1000)
        ) {
            let runtime = tokio::runtime::Runtime::new().unwrap();
            runtime.block_on(async {
                let manager = Arc::new(CoalescingManager::new());
                let results = Arc::new(tokio::sync::Mutex::new(HashMap::new()));

                let handles: Vec<_> = request_patterns.into_iter().map(|(req_id, _)| {
                    let mgr = manager.clone();
                    let res = results.clone();
                    tokio::spawn(async move {
                        let result = mgr.execute_or_wait(req_id, || async {
                            req_id * 2  // Deterministic result
                        }).await;

                        res.lock().await.entry(req_id).or_insert_with(Vec::new).push(result);
                    })
                }).collect();

                for h in handles {
                    h.await.unwrap();
                }

                // Verify: All requests with same ID got same result
                for (req_id, results_vec) in results.lock().await.iter() {
                    for result in results_vec {
                        prop_assert_eq!(*result, req_id * 2);
                    }
                }

                Ok(())
            })?;
        }

        /// Property: N identical concurrent requests → 1 provider call
        ///
        /// Invariant: coalesced_calls = 1 for all N > 1
        #[test]
        fn prop_coalescing_reduces_calls(
            concurrent_identical in 2usize..1000
        ) {
            let runtime = tokio::runtime::Runtime::new().unwrap();
            runtime.block_on(async {
                let manager = Arc::new(CoalescingManager::new());
                let call_count = Arc::new(AtomicU64::new(0));

                let handles: Vec<_> = (0..concurrent_identical).map(|_| {
                    let mgr = manager.clone();
                    let count = call_count.clone();
                    tokio::spawn(async move {
                        mgr.execute_or_wait(42, || async {
                            count.fetch_add(1, Ordering::Relaxed);
                            "result"
                        }).await
                    })
                }).collect();

                for h in handles {
                    h.await.unwrap();
                }

                // Should execute exactly once
                prop_assert_eq!(call_count.load(Ordering::Relaxed), 1);
                Ok(())
            })?;
        }

        /// Property: Different hashes → independent executions
        ///
        /// Invariant: distinct_hashes(N) → N provider calls
        #[test]
        fn prop_different_hashes_no_coalescing(
            num_different in 1usize..100
        ) {
            let runtime = tokio::runtime::Runtime::new().unwrap();
            runtime.block_on(async {
                let manager = Arc::new(CoalescingManager::new());
                let call_count = Arc::new(AtomicU64::new(0));

                let handles: Vec<_> = (0..num_different).map(|i| {
                    let mgr = manager.clone();
                    let count = call_count.clone();
                    tokio::spawn(async move {
                        mgr.execute_or_wait(i as u64, || async {
                            count.fetch_add(1, Ordering::Relaxed);
                            i
                        }).await
                    })
                }).collect();

                for h in handles {
                    h.await.unwrap();
                }

                // Each unique hash should execute
                prop_assert_eq!(call_count.load(Ordering::Relaxed), num_different as u64);
                Ok(())
            })?;
        }

        /// Property: Cleanup prevents memory leaks
        ///
        /// Invariant: in_flight_count eventually → 0
        #[test]
        fn prop_cleanup_prevents_leaks(
            iterations in 10usize..100
        ) {
            let runtime = tokio::runtime::Runtime::new().unwrap();
            runtime.block_on(async {
                let manager = Arc::new(CoalescingManager::new());

                for i in 0..iterations {
                    manager.execute_or_wait(i as u64, || async {
                        tokio::time::sleep(Duration::from_millis(1)).await;
                        i
                    }).await;
                }

                // Wait for cleanup
                tokio::time::sleep(Duration::from_millis(100)).await;

                // All in-flight entries should be cleaned up
                prop_assert_eq!(manager.in_flight_count(), 0);
                Ok(())
            })?;
        }
    }
}

