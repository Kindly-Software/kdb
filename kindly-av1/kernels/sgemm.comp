// SGEMM Compute Shader for GPU Stress Benchmark
// C = alpha * A @ B + beta * C
//
// [TRADE SECRET] - PROPRIETARY AND CONFIDENTIAL
//
// Framework Compliance:
// - UCE34: Q10 T7 Heterogeneous tier (GPU matmul)
// - COCA: Cache-tiled algorithm for optimal memory access
// - B32: Designed for benchmark comparison against CPU baseline
//
// Workgroup: 16x16 threads, each computes one element of C
// Uses shared memory for tile-based multiplication to maximize cache reuse

#version 450

// Workgroup size: 16x16 = 256 threads (optimal for most GPUs)
layout(local_size_x = 16, local_size_y = 16, local_size_z = 1) in;

// Push constants for matrix dimensions and scalar coefficients
layout(push_constant) uniform PushConstants {
    uint M;      // Rows of A and C
    uint N;      // Columns of B and C
    uint K;      // Columns of A / Rows of B
    uint alpha_bits;  // alpha as u32 bits (float reinterpret)
    uint beta_bits;   // beta as u32 bits (float reinterpret)
    uint _padding;    // Alignment padding
} pc;

// Storage buffers for matrices (row-major layout)
// A: M x K matrix
layout(std430, binding = 0) readonly buffer MatrixA {
    float A[];
};

// B: K x N matrix
layout(std430, binding = 1) readonly buffer MatrixB {
    float B[];
};

// C: M x N matrix (input/output)
layout(std430, binding = 2) buffer MatrixC {
    float C[];
};

// Shared memory tiles for cache reuse (16x16 tiles)
// This dramatically reduces global memory bandwidth requirements
shared float tileA[16][16];
shared float tileB[16][16];

// Convert u32 bits back to float
float bitsToFloat(uint bits) {
    return uintBitsToFloat(bits);
}

void main() {
    // Global thread IDs (which element of C this thread computes)
    uint globalRow = gl_GlobalInvocationID.y;
    uint globalCol = gl_GlobalInvocationID.x;

    // Local thread IDs within workgroup
    uint localRow = gl_LocalInvocationID.y;
    uint localCol = gl_LocalInvocationID.x;

    // Decode push constants
    float alpha = bitsToFloat(pc.alpha_bits);
    float beta = bitsToFloat(pc.beta_bits);

    // Accumulator for dot product
    float acc = 0.0;

    // Number of tiles needed to cover K dimension
    uint numTiles = (pc.K + 15) / 16;

    // Loop over tiles
    for (uint t = 0; t < numTiles; t++) {
        // Tile offset in K dimension
        uint tileOffset = t * 16;

        // Load tile of A into shared memory
        // Each thread loads one element
        uint aRow = globalRow;
        uint aCol = tileOffset + localCol;
        if (aRow < pc.M && aCol < pc.K) {
            tileA[localRow][localCol] = A[aRow * pc.K + aCol];
        } else {
            tileA[localRow][localCol] = 0.0;
        }

        // Load tile of B into shared memory
        uint bRow = tileOffset + localRow;
        uint bCol = globalCol;
        if (bRow < pc.K && bCol < pc.N) {
            tileB[localRow][localCol] = B[bRow * pc.N + bCol];
        } else {
            tileB[localRow][localCol] = 0.0;
        }

        // Synchronize to ensure all threads have loaded their tiles
        barrier();

        // Compute partial dot product for this tile
        // Each thread computes contribution to its C element
        for (uint k = 0; k < 16; k++) {
            acc += tileA[localRow][k] * tileB[k][localCol];
        }

        // Synchronize before loading next tile
        barrier();
    }

    // Write result to C if within bounds
    // C = alpha * A @ B + beta * C
    if (globalRow < pc.M && globalCol < pc.N) {
        uint idx = globalRow * pc.N + globalCol;
        C[idx] = alpha * acc + beta * C[idx];
    }
}
