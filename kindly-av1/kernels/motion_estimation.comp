#version 450
#extension GL_EXT_scalar_block_layout : enable
#extension GL_EXT_nonuniform_qualifier : enable

// Diamond search motion estimation for AV1 encoding
// [TRADE SECRET] - PROPRIETARY AND CONFIDENTIAL
//
// Algorithm: Multi-stage diamond search
// 1. Large diamond (±search_range/2) - coarse search
// 2. Small diamond (±2 pixels) - refinement
// 3. Sub-pixel refinement (half-pel, quarter-pel)
//
// Performance targets:
// - 1080p: <2ms (GPU) vs 1.37ms (CPU)
// - 4K: <8ms (GPU) vs ~5.5ms (CPU estimated)
// - 8K: <30ms (GPU)

// Workgroup: 16x16 threads = one macroblock
layout(local_size_x = 16, local_size_y = 16, local_size_z = 1) in;

// Current frame (luma only, 8-bit)
// Note: Runtime-sized arrays require explicit extension
layout(set = 0, binding = 0, scalar) readonly buffer CurrentFrame {
    uint current_pixels[];  // Runtime-sized array (GLSL 4.30+)
};

// Reference frame (luma only, 8-bit)
layout(set = 0, binding = 1, scalar) readonly buffer ReferenceFrame {
    uint reference_pixels[];  // Runtime-sized array (GLSL 4.30+)
};

// Output motion vectors
// Format: [x: i16, y: i16, sad: u32] per macroblock
layout(set = 0, binding = 2, scalar) writeonly buffer MotionVectors {
    uvec2 motion_vectors[];  // Runtime-sized array (GLSL 4.30+)
};

// Push constants for frame parameters
layout(push_constant) uniform PushConstants {
    int width;         // Frame width
    int height;        // Frame height
    int search_range;  // Search range (typically 16 or 32)
    int mb_cols;       // Macroblocks per row
    int mb_rows;       // Macroblocks per column
} params;

// Shared memory for SAD computation
shared uint shared_sad[256];  // 16x16 threads

// Get pixel value from current frame
uint get_current_pixel(int x, int y, int stride) {
    // Bounds check
    if (x < 0 || x >= stride || y < 0 || y >= params.height) {
        return 128;  // Gray for out-of-bounds
    }

    int byte_idx = y * stride + x;
    int uint_idx = byte_idx >> 2;
    int byte_offset = byte_idx & 3;

    return (current_pixels[uint_idx] >> (byte_offset * 8)) & 0xFF;
}

// Get pixel value from reference frame
uint get_reference_pixel(int x, int y, int stride) {
    // Bounds check
    if (x < 0 || x >= stride || y < 0 || y >= params.height) {
        return 128;  // Gray for out-of-bounds
    }

    int byte_idx = y * stride + x;
    int uint_idx = byte_idx >> 2;
    int byte_offset = byte_idx & 3;

    return (reference_pixels[uint_idx] >> (byte_offset * 8)) & 0xFF;
}

// Compute 16x16 SAD between current block and reference at offset
uint compute_sad(int mb_x, int mb_y, int mv_x, int mv_y) {
    // Each thread handles one pixel
    int local_x = int(gl_LocalInvocationID.x);
    int local_y = int(gl_LocalInvocationID.y);

    // Current block position
    int cur_x = mb_x * 16 + local_x;
    int cur_y = mb_y * 16 + local_y;

    // Reference block position (with motion vector offset)
    int ref_x = cur_x + mv_x;
    int ref_y = cur_y + mv_y;

    // Get pixel values
    uint cur_pixel = get_current_pixel(cur_x, cur_y, params.width);
    uint ref_pixel = get_reference_pixel(ref_x, ref_y, params.width);

    // Compute absolute difference
    uint diff = (cur_pixel > ref_pixel) ? (cur_pixel - ref_pixel) : (ref_pixel - cur_pixel);

    // Store to shared memory
    shared_sad[local_y * 16 + local_x] = diff;

    barrier();

    // Parallel reduction to sum all 256 differences
    // Stage 1: 256 -> 128
    if (gl_LocalInvocationIndex < 128) {
        shared_sad[gl_LocalInvocationIndex] += shared_sad[gl_LocalInvocationIndex + 128];
    }
    barrier();

    // Stage 2: 128 -> 64
    if (gl_LocalInvocationIndex < 64) {
        shared_sad[gl_LocalInvocationIndex] += shared_sad[gl_LocalInvocationIndex + 64];
    }
    barrier();

    // Stage 3: 64 -> 32
    if (gl_LocalInvocationIndex < 32) {
        shared_sad[gl_LocalInvocationIndex] += shared_sad[gl_LocalInvocationIndex + 32];
    }
    barrier();

    // Final stages in single warp (no barrier needed)
    if (gl_LocalInvocationIndex < 16) {
        shared_sad[gl_LocalInvocationIndex] += shared_sad[gl_LocalInvocationIndex + 16];
    }
    if (gl_LocalInvocationIndex < 8) {
        shared_sad[gl_LocalInvocationIndex] += shared_sad[gl_LocalInvocationIndex + 8];
    }
    if (gl_LocalInvocationIndex < 4) {
        shared_sad[gl_LocalInvocationIndex] += shared_sad[gl_LocalInvocationIndex + 4];
    }
    if (gl_LocalInvocationIndex < 2) {
        shared_sad[gl_LocalInvocationIndex] += shared_sad[gl_LocalInvocationIndex + 2];
    }
    if (gl_LocalInvocationIndex < 1) {
        shared_sad[0] += shared_sad[1];
    }

    barrier();
    return shared_sad[0];
}

// Diamond search pattern offsets
// Large diamond (radius 4): 9 positions
const ivec2 LARGE_DIAMOND[9] = ivec2[9](
    ivec2(0, 0),    // Center
    ivec2(0, -4),   // N
    ivec2(4, 0),    // E
    ivec2(0, 4),    // S
    ivec2(-4, 0),   // W
    ivec2(2, -2),   // NE
    ivec2(2, 2),    // SE
    ivec2(-2, 2),   // SW
    ivec2(-2, -2)   // NW
);

// Small diamond (radius 1): 5 positions
const ivec2 SMALL_DIAMOND[5] = ivec2[5](
    ivec2(0, 0),    // Center
    ivec2(0, -1),   // N
    ivec2(1, 0),    // E
    ivec2(0, 1),    // S
    ivec2(-1, 0)    // W
);

void main() {
    // Each workgroup processes one macroblock
    int mb_x = int(gl_WorkGroupID.x);
    int mb_y = int(gl_WorkGroupID.y);

    // Bounds check
    if (mb_x >= params.mb_cols || mb_y >= params.mb_rows) {
        return;
    }

    // Initialize best motion vector at (0, 0)
    int best_x = 0;
    int best_y = 0;
    uint best_sad = compute_sad(mb_x, mb_y, 0, 0);

    // Thread 0 coordinates the search (all threads participate in SAD)
    bool is_thread_0 = (gl_LocalInvocationIndex == 0);

    // Stage 1: Large diamond search with early termination
    int search_step = params.search_range / 4;
    while (search_step >= 4) {
        bool improved = false;

        for (int i = 1; i < 9; i++) {  // Skip center (already computed)
            int test_x = best_x + LARGE_DIAMOND[i].x * (search_step / 4);
            int test_y = best_y + LARGE_DIAMOND[i].y * (search_step / 4);

            // Clamp to search range
            test_x = clamp(test_x, -params.search_range, params.search_range);
            test_y = clamp(test_y, -params.search_range, params.search_range);

            uint sad = compute_sad(mb_x, mb_y, test_x, test_y);

            if (is_thread_0 && sad < best_sad) {
                best_sad = sad;
                best_x = test_x;
                best_y = test_y;
                improved = true;
            }

            // Early termination for static blocks
            if (best_sad < 256) {  // Very low SAD = nearly identical
                break;
            }
        }

        if (!improved) {
            search_step /= 2;
        }
    }

    // Stage 2: Small diamond refinement
    for (int iter = 0; iter < 4; iter++) {
        bool improved = false;

        for (int i = 1; i < 5; i++) {
            int test_x = best_x + SMALL_DIAMOND[i].x;
            int test_y = best_y + SMALL_DIAMOND[i].y;

            // Clamp to search range
            test_x = clamp(test_x, -params.search_range, params.search_range);
            test_y = clamp(test_y, -params.search_range, params.search_range);

            uint sad = compute_sad(mb_x, mb_y, test_x, test_y);

            if (is_thread_0 && sad < best_sad) {
                best_sad = sad;
                best_x = test_x;
                best_y = test_y;
                improved = true;
            }
        }

        if (!improved) break;
    }

    // Write result (thread 0 only)
    if (is_thread_0) {
        int mv_idx = mb_y * params.mb_cols + mb_x;

        // Pack x and y into first uvec (i16, i16) -> quarter-pel (* 4)
        int qpel_x = best_x * 4;  // Convert to quarter-pel
        int qpel_y = best_y * 4;
        uint xy_packed = (uint(qpel_x & 0xFFFF)) | (uint(qpel_y & 0xFFFF) << 16);

        motion_vectors[mv_idx] = uvec2(xy_packed, best_sad);
    }
}
