  <metadata>
    <created>2025-11-05T21:30:00Z</created>
    <author>Implementation Expert 2</author>
    <project>kindly-web</project>
    <capsules>
      <capsule>HolographicCapsule</capsule>
      <capsule>MetallicTextCapsule</capsule>
    </capsules>
