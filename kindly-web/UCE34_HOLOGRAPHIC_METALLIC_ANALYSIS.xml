  </metadata>

  <q1-problem-definition>
    <problem>
      <name>Holographic Background Animation</name>
      <description>Real-time 4-layer gradient animation with mosaic patterns, vignette effects, and noise for holographic visual effect in browser WASM environment</description>
      <current-approach>Traditional JavaScript/CSS animations with high overhead, non-deterministic timing</current-approach>
      <bottleneck>Per-frame recalculation overhead, floating-point imprecision in animation timing</bottleneck>
    </problem>
    <problem>
      <name>Metallic Text Shimmer Effect</name>
      <description>Deterministic gold shimmer effect for text with precise timing and color transitions</description>
      <current-approach>CSS-based shimmer with floating-point timing, non-reproducible across browsers</current-approach>
      <bottleneck>Floating-point drift in shimmer phase, inconsistent color interpolation</bottleneck>
    </problem>
  </q1-problem-definition>

  <q10-tier-selection>
    <holographic-capsule>
      <tier>T5 Streaming</tier>
      <rationale>O(1) incremental updates, continuous animation stream, windowed state management</rationale>
      <alternatives-rejected>
        <alternative tier="T1" reason="No streaming/incremental capability"/>
        <alternative tier="T2" reason="SIMD not beneficial for single-frame updates"/>
        <alternative tier="T4" reason="Batch not suitable for real-time animation"/>
      </alternatives-rejected>
      <primitive-recommendation>
        <primitive id="StreamingGradientCapsule" tier="T5" alignment="128B"/>
        <primitive id="AtomicU64" tier="T1" use="animation_time atomic coordination"/>
        <primitive id="Simd_f32_4" tier="T2" use="RGBA gradient vectorization"/>
      </primitive-recommendation>
    </holographic-capsule>

    <metallic-text-capsule>
      <tier>T3 Fixed-Point</tier>
      <rationale>Deterministic shimmer phase (Q16.16), zero FP drift, reproducible across all platforms</rationale>
      <alternatives-rejected>
        <alternative tier="T1" reason="No deterministic precision for color math"/>
        <alternative tier="T2" reason="Not a vectorization problem (single shimmer)"/>
        <alternative tier="T5" reason="Not a streaming problem (simple phase update)"/>
      </alternatives-rejected>
      <primitive-recommendation>
        <primitive id="Q16_16" tier="T3" use="gold_base, gold_highlight, shimmer_phase, shimmer_speed"/>
        <primitive id="AtomicU32" tier="T1" use="atomic storage of Q16.16 values"/>
      </primitive-recommendation>
    </metallic-text-capsule>
  </q10-tier-selection>

  <q11-rust-transformation>
    <holographic-capsule>
      <approach>Rust WASM with leptos framework, SIMD for gradient computation, atomic coordination</approach>
      <features>
        <feature>portable_simd (nightly) - Simd&lt;f32, 4&gt; for RGBA gradients</feature>
        <feature>wasm32-unknown-unknown target</feature>
        <feature>atomic_capsule primitives (AtomicU64, AtomicU32)</feature>
      </features>
      <memory-layout>
        <alignment>128B (SIMD-aligned, cache-line separated)</alignment>
        <size>128B (complete structure)</size>
        <fields>
          <field name="base_gradient" type="Simd&lt;f32, 4&gt;" offset="0" size="16"/>
          <field name="mosaic_pattern" type="AtomicU64" offset="16" size="8"/>
          <field name="vignette_strength" type="AtomicU32" offset="24" size="4"/>
          <field name="noise_seed" type="AtomicU64" offset="32" size="8"/>
          <field name="animation_time" type="AtomicU64" offset="40" size="8"/>
          <field name="shift_rate" type="AtomicU32" offset="48" size="4"/>
          <field name="_padding" type="[u8; 68]" offset="60" size="68"/>
        </fields>
      </memory-layout>
    </holographic-capsule>

    <metallic-text-capsule>
      <approach>Rust WASM with Q16.16 fixed-point arithmetic, atomic storage</approach>
      <features>
        <feature>atomic_capsule fixed-point primitives (Q16_16)</feature>
        <feature>wasm32-unknown-unknown target</feature>
        <feature>deterministic color interpolation</feature>
      </features>
      <memory-layout>
        <alignment>64B (cache-line aligned)</alignment>
        <size>64B (complete structure)</size>
        <fields>
          <field name="gold_base" type="AtomicU32" offset="0" size="4" format="Q16.16"/>
          <field name="gold_highlight" type="AtomicU32" offset="4" size="4" format="Q16.16"/>
          <field name="shimmer_phase" type="AtomicU32" offset="8" size="4" format="Q16.16"/>
          <field name="shimmer_speed" type="AtomicU32" offset="12" size="4" format="Q16.16"/>
          <field name="_padding" type="[u8; 48]" offset="16" size="48"/>
        </fields>
      </memory-layout>
    </metallic-text-capsule>
  </q11-rust-transformation>

  <q12-nightly-optimization>
    <holographic-capsule>
      <features>
        <feature name="portable_simd" priority="MANDATORY">
          <reason>Simd&lt;f32, 4&gt; for RGBA gradient computation (2-4× speedup)</reason>
          <benefit>Vectorized gradient interpolation, single instruction for 4 color channels</benefit>
          <fallback>Scalar RGBA operations (acceptable for browser animation)</fallback>
        </feature>
      </features>
    </holographic-capsule>

    <metallic-text-capsule>
      <features>
        <feature name="const_fn_floating_point" priority="OPTIONAL">
          <reason>Compile-time Q16.16 constant calculation for gold colors</reason>
          <benefit>0ns runtime cost for shimmer color constants</benefit>
          <fallback>Runtime Q16.16 conversion (marginal <5ns overhead)</fallback>
        </feature>
      </features>
    </metallic-text-capsule>
  </q12-nightly-optimization>

  <q13-q20-implementation-details>
    <holographic-capsule>
      <q13-edge-cases>
        <edge-case>animation_time overflow (64-bit microseconds wrap after 584,942 years)</edge-case>
        <edge-case>noise_seed collision (use generation counter + timestamp)</edge-case>
        <edge-case>vignette_strength saturation (Q16.16 max 65535.99998)</edge-case>
      </q13-edge-cases>

      <q14-constraints>
        <constraint>WASM single-threaded (no CAS contention)</constraint>
        <constraint>Browser requestAnimationFrame timing (16.67ms target, variable actual)</constraint>
        <constraint>128B alignment (browser WASM heap may not guarantee)</constraint>
      </q14-constraints>

      <q15-scalability>
        <scale>Single capsule per page (global background animation)</scale>
        <limit>No scaling concern (1 instance max)</limit>
      </q15-scalability>

      <q16-security>
        <threat>None (client-side visual effect, no sensitive data)</threat>
        <timing-attack>N/A (animation timing is public)</timing-attack>
      </q16-security>

      <q17-failure-modes>
        <failure mode="SIMD unavailable">Graceful fallback to scalar RGBA operations</failure>
        <failure mode="Animation stutter">Acceptable (visual glitch, no data corruption)</failure>
        <failure mode="Color overflow">Saturating Q16.16 arithmetic (clamp to [0, 1])</failure>
      </q17-failure-modes>

      <q18-interfaces>
        <interface>update_frame(delta_ms: f32) -&gt; Result&lt;(), AnimationError&gt;</interface>
        <interface>get_current_color() -&gt; [f32; 4] (RGBA)</interface>
        <interface>set_animation_speed(rate: f32)</interface>
      </q18-interfaces>

      <q19-dependencies>
        <dependency>atomic_capsule (SIMD primitives, AtomicU64/U32)</dependency>
        <dependency>leptos (WASM framework, no runtime dep)</dependency>
      </q19-dependencies>

      <q20-monitoring>
        <metric>frames_rendered: AtomicU64 (frame counter)</metric>
        <metric>average_frame_time: AtomicU32 (Q16.16 ms)</metric>
      </q20-monitoring>
    </holographic-capsule>

    <metallic-text-capsule>
      <q13-edge-cases>
        <edge-case>shimmer_phase wrap (0.0-1.0 cyclic, use modulo)</edge-case>
        <edge-case>shimmer_speed zero (static gold color, no animation)</edge-case>
        <edge-case>gold color out of range (clamp Q16.16 to [0, 1])</edge-case>
      </q13-edge-cases>

      <q14-constraints>
        <constraint>WASM single-threaded (no CAS required)</constraint>
        <constraint>Deterministic color (Q16.16 eliminates FP drift)</constraint>
        <constraint>64B alignment (browser WASM heap compatibility)</constraint>
      </q14-constraints>

      <q15-scalability>
        <scale>Multiple instances per page (one per text element)</scale>
        <limit>100-1000 instances acceptable (&lt;64KB total memory)</limit>
      </q15-scalability>

      <q16-security>
        <threat>None (client-side visual effect)</threat>
        <timing-attack>N/A</timing-attack>
      </q16-security>

      <q17-failure-modes>
        <failure mode="Overflow">Saturating Q16.16 clamp to [0, 1]</failure>
        <failure mode="Zero speed">Static gold color (acceptable)</failure>
      </q17-failure-modes>

      <q18-interfaces>
        <interface>update_shimmer(delta_ms: f32) -&gt; Result&lt;(), ShimmerError&gt;</interface>
        <interface>get_current_gold() -&gt; u32 (Q16.16 color value)</interface>
        <interface>set_shimmer_speed(cycles_per_sec: f32)</interface>
      </q18-interfaces>

      <q19-dependencies>
        <dependency>atomic_capsule (Q16_16 primitives, AtomicU32)</dependency>
        <dependency>leptos (WASM framework)</dependency>
      </q19-dependencies>

      <q20-monitoring>
        <metric>shimmer_updates: AtomicU64 (update counter)</metric>
        <metric>current_phase: AtomicU32 (Q16.16 phase [0, 1])</metric>
      </q20-monitoring>
    </metallic-text-capsule>
  </q13-q20-implementation-details>

  <q21-q28-integration-simplicity>
    <q21-integration-points>
      <holographic>leptos component, requestAnimationFrame callback, CSS background injection</holographic>
      <metallic>leptos component, text element style attribute, CSS color property</metallic>
    </q21-integration-points>

    <q22-rollout-strategy>
      <phase>1. Unit tests (T28 Q1-Q7)</phase>
      <phase>2. Property tests (T28 Q8-Q14, Q16.16 determinism)</phase>
      <phase>3. Integration tests (T28 Q15-Q21, leptos component)</phase>
      <phase>4. Production deployment (gradual, feature flag)</phase>
    </q22-rollout-strategy>

    <q28-simplicity>
      <holographic>Simple public API: new(), update_frame(), get_color()</holographic>
      <metallic>Simple public API: new(), update_shimmer(), get_gold()</metallic>
      <principle>Hide complexity: Q16.16 conversions internal, atomic operations transparent</principle>
    </q28-simplicity>
  </q21-q28-integration-simplicity>

  <q29-q34-performance-compliance>
    <q29-latency-target>
      <holographic>Target: &lt;100ns per frame update (60 FPS = 16.67ms budget, negligible overhead)</holographic>
      <metallic>Target: &lt;20ns shimmer calculation (thousands per frame acceptable)</metallic>
    </q29-latency-target>

    <q30-validation>
      <b32-benchmark>
        <holographic>1000 iterations, 95% CI, measure update_frame() latency</holographic>
        <metallic>1000 iterations, 95% CI, measure update_shimmer() + Q16.16 interpolation</metallic>
        <baseline>Scalar fallback (no SIMD) for HolographicCapsule</baseline>
        <baseline>Floating-point shimmer for MetallicTextCapsule</baseline>
      </b32-benchmark>
    </q30-validation>

    <q31-rust-features>
      <feature>portable_simd (HolographicCapsule)</feature>
      <feature>const_fn_floating_point (MetallicTextCapsule, optional)</feature>
      <feature>atomic_capsule primitives (both)</feature>
    </q31-rust-features>

    <q32-nightly-requirements>
      <holographic>Nightly REQUIRED (portable_simd for Simd&lt;f32, 4&gt;)</holographic>
      <metallic>Stable acceptable (Q16.16 via atomic_capsule stable primitives)</metallic>
    </q32-nightly-requirements>

    <q33-verification>
      <holographic>
        <macro>#[derive(ComputationalCapsule)]</macro>
        <attributes>#[capsule(alignment = 128, size = 128)]</attributes>
        <compile-time>Alignment and size verification at compile-time</compile-time>
