      <memory-layout>
        <field offset="0-7" size="8" type="AtomicU64">balance (current budget in cents)</field>
        <field offset="8-15" size="8" type="AtomicU64">total_deducted (cumulative deductions)</field>
        <field offset="16-23" size="8" type="AtomicU64">total_credited (cumulative credits)</field>
        <field offset="24-31" size="8" type="AtomicU64">success_count (successful operations)</field>
        <field offset="32-39" size="8" type="AtomicU64">failure_count (failed operations, overflow)</field>
        <field offset="40-127" size="88" type="[u8; 88]">_padding (cache line alignment)</field>
        <total>128 bytes (dual cache line, no false sharing with adjacent data)</total>
      </memory-layout>

      <api>
        <method name="new" latency="0ns">fn new(initial_balance: u64) -&gt; Self</method>
        <method name="deduct" latency="30ns">fn deduct(&amp;self, amount: u64) -&gt; Result&lt;u64&gt;</method>
        <method name="credit" latency="15ns">fn credit(&amp;self, amount: u64) -&gt; u64</method>
        <method name="get_balance" latency="5ns">fn get_balance(&amp;self) -&gt; u64</method>
        <method name="get_totals" latency="15ns">fn get_totals(&amp;self) -&gt; (u64, u64)</method>
        <method name="get_audit" latency="10ns">fn get_audit(&amp;self) -&gt; (u64, u64)</method>
      </api>

      <performance>
        <metric name="deduct_latency">~30ns (CAS loop with overflow check, typically 1-2 iterations)</metric>
        <metric name="credit_latency">~15ns (fetch_add, no overflow check needed)</metric>
        <metric name="audit_latency">~10ns (2× atomic loads for success/failure counts)</metric>
        <metric name="memory">128B (dual cache line for 5 counters)</metric>
      </performance>

      <safety>
        <assume tag="CAS-Deduct">CAS loop prevents race conditions on balance deduction (retry on concurrent updates)</assume>
        <assume tag="Overflow-Check">Deduct checks balance &gt;= amount before subtract (prevents underflow)</assume>
